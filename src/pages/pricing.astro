---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { whatsappLink } from '../data/site';
import BookingWidget from '../components/BookingWidget.astro';

const rentalRates = [
  { period: 'Under 3 days', rate: '$65', per: 'per day' },
  { period: '3 to 7 days', rate: '$60', per: 'per day' },
  { period: 'Over 7 days', rate: '$55', per: 'per day' },
  { period: '2 weeks or more', rate: '$50', per: 'per day' },
];

const extras = [
  { label: 'Security deposit', detail: 'Held on card or in cash, refunded on return. Amount depends on quad type.' },
  { label: 'Fuel', detail: 'Full at pickup, full on return. Refuelling on your behalf is charged at cost.' },
  { label: 'Delivery', detail: 'Free in Santa Teresa, Playa Carmen and Mal País. Small fee to Manzanillo or Montezuma.' },
  { label: 'Optional damage cover', detail: 'Available per day. Reduces what you are liable for if the quad comes back damaged.' },
  { label: 'Payment', detail: 'Cash in colones or US dollars, or card. Nothing is charged until pickup.' },
];
---

<BaseLayout
  title="ATV rental prices in Santa Teresa | Rent ATV Santa Teresa"
  description="ATV rental prices in Santa Teresa, Costa Rica. Half-day, full-day and weekly quad rates with helmets, insurance and free hotel delivery included."
>
  <Breadcrumb items={[{ label: 'Pricing', href: '/pricing' }]} />
  <PageHero
    eyebrow="Rates"
    title="Pricing"
    subtitle="Every rate includes helmets, fuel at pickup, basic insurance and free delivery within Santa Teresa. No booking fee and nothing added at the counter."
  />

  <section class="page-x section-y" aria-labelledby="rental-rates">
    <SectionHeading
      eyebrow="Self-drive"
      title="Rental rates"
      subtitle="Rates are per quad, not per person, and a passenger rides at no extra charge. Every rate includes helmets, the cargo box and free delivery in Santa Teresa."
    />

    <div class="mt-8 overflow-x-auto">
      <table class="w-full min-w-[28rem] border-collapse text-left text-base">
        <caption class="sr-only">ATV rental rates in Santa Teresa by length of rental</caption>
        <thead>
          <tr class="border-b border-hairline">
            <th scope="col" class="py-3 pr-4 text-body font-semibold text-muted">Length of rental</th>
            <th scope="col" class="py-3 text-body font-semibold text-muted">Fully automatic 4x4 ATV</th>
          </tr>
        </thead>
        <tbody>
          {rentalRates.map((row) => (
            <tr class="border-b border-hairline">
              <th scope="row" class="py-4 pr-4 font-normal text-ink-2">{row.period}</th>
              <td class="py-4">
                <span class="text-h4 font-semibold text-ink-2">{row.rate}</span>
                <span class="ml-1 text-body text-muted">{row.per}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-base text-muted">
      See what comes with each rental on the
      <a href="/atv-rentals" class="link-inline">ATV rentals page</a>.
    </p>
  </section>

  <!-- Widget sits here: visitor just read the rates, now they can act -->
  <section class="page-x section-y" aria-labelledby="book-pricing">
    <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:gap-12 lg:items-start">
      <div>
        <h2 id="book-pricing" class="text-h3 font-semibold text-ink-2">Ready to book?</h2>
        <p class="mt-3 text-base text-muted">
          Pick your dates and we will send you a confirmation on WhatsApp.
          Not sure of your dates yet?
        </p>
        <a
          href="https://wa.me/{site.whatsappNumber}?text={encodeURIComponent('Hi! I have a question about ATV rental rates in Santa Teresa.')}"
          class="btn-secondary mt-5 inline-flex"
          rel="noopener"
          target="_blank"
        >
          Message us directly
        </a>
      </div>
      <BookingWidget compact={true} />
    </div>
  </section>

  <section class="band-sand" aria-labelledby="extras">
    <div class="page-x section-y">
    <div class="max-w-3xl">
      <SectionHeading eyebrow="The fine print" title="Deposits, fuel and extras" />
      <dl class="mt-8 divide-y divide-hairline border-t border-hairline">
        {extras.map((item) => (
          <div class="flex flex-col gap-1 py-5 sm:flex-row sm:justify-between sm:gap-8">
            <dt class="font-semibold text-ink-2">{item.label}</dt>
            <dd class="text-base text-muted sm:max-w-md sm:text-right">{item.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
    </div>
  </section>

  <CtaBand
    title="Get a quote"
    body="Rates shift slightly between high and green season. Send your dates and we will confirm the exact price."
    message="Hi! I'd like to book an ATV rental in Santa Teresa."
  />
</BaseLayout>
