---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import RouteStrip from '../components/RouteStrip.astro';
import BookingWidget from '../components/BookingWidget.astro';
import Photo from '../components/Photo.astro';
import StatBand from '../components/StatBand.astro';
import StickyCta from '../components/StickyCta.astro';
import InfoCard from '../components/InfoCard.astro';
import { site, rates } from '../data/site';
import { localBusinessSchema, websiteSchema, faqSchema, serviceSchema } from '../data/schema';

const faqs = [
  {
    q: 'Do I need a licence to rent an ATV in Santa Teresa?',
    a: 'Yes. Costa Rican law requires a valid driver’s licence from your home country to operate an ATV on public roads. A standard car licence is enough — you do not need a motorcycle endorsement. Bring the physical licence, not a photo of it.',
  },
  {
    q: 'Can you deliver the ATV to my hotel?',
    a: 'Yes, and it is free anywhere in Santa Teresa, Mal País, Playa Carmen and Playa Hermosa. We bring the quad to you, walk you through the controls and collect it from the same spot when your rental ends. Delivery to Cóbano or Cabuya is available for an extra fee.',
  },
  {
    q: 'Is insurance included?',
    a: 'Basic liability coverage is included in every rental. We will explain what it does and does not cover before you sign, so there are no surprises. Optional damage coverage is available if you would rather not carry the risk on the rougher inland trails.',
  },
  {
    q: 'What are the roads actually like?',
    a: 'The main coastal road through Santa Teresa is paved, but the side roads, hill routes, and the stretch toward Montezuma are unpaved and can get rutted and dusty in dry season, then soft and washed-out in green season. It is exactly why so many visitors ride quads here rather than drive. Inland routes toward Manzanillo include steep sections and river crossings, so ask us about current conditions before heading that way.',
  },
  { q: 'Can two people ride one ATV?', a: 'Yes. Every quad in our fleet can accommodate one or two riders.' },
  { q: 'Can I ride to Montezuma?', a: 'Yes. It is approximately 22 km and takes around 50 minutes depending on conditions.' },
  { q: 'Is fuel included?', a: 'The tank is full when you pick up and is expected to come back full. Fuel itself is not included in the rental price, but you always start with a full tank.' },
  { q: 'Are helmets included?', a: 'Yes. One helmet per rider, included with every rental.' },
  { q: 'Can I rent for a week?', a: 'Yes. Longer rentals have discounted daily rates starting from 3 days.' },
];

const schema = [
  localBusinessSchema,
  websiteSchema,
  serviceSchema({
    name: 'ATV rental in Santa Teresa, Costa Rica',
    description:
      'Rent a fully automatic 4x4 ATV in Santa Teresa, Costa Rica. Mixed fleet of Can-Am, Honda and Kymco. Helmets and free hotel delivery included, full tank at pickup. From $50/day.',
    url: site.url,
    offers: rates.map((tier) => ({ price: tier.price, description: `Daily rate, ${tier.label.toLowerCase()}` })),
  }),
  faqSchema(faqs),
];

const fleet = [
  {
    photo: 'fleet-canam-side',
    alt: 'Red Can-Am Outlander 450 4x4 ATV available for rent in Santa Teresa',
    name: 'Can-Am Outlander 4x4',
    body: 'The Can-Am Outlander is one of the most capable machines we run. Fully automatic with selectable 4x4, it handles the unpaved tracks, the hill roads, and the muddy green-season sections without difficulty. A solid choice for riders who want to explore beyond the main road.',
    specs: ['Fully automatic', 'Selectable 4x4', '1–2 riders', 'Locking cargo box'],
  },
  {
    photo: 'fleet-honda-side',
    alt: 'Honda ATV with front and rear racks available for rent in Santa Teresa',
    name: 'Honda ATV',
    body: 'The Honda in our fleet is reliable, easy to ride, and well suited to the coast road between Santa Teresa and Mal País. Fully automatic, comfortable for one or two riders, and fitted with a cargo box on the back for bags, towels, and beach gear.',
    specs: ['Fully automatic', '1–2 riders', 'Front and rear racks', 'Locking cargo box'],
  },
  {
    photo: 'fleet-kymco-front',
    alt: 'Black Kymco 4x4 ATV available for rent in Santa Teresa',
    name: 'Kymco 4x4 ATV',
    body: 'The Kymco is straightforward and easy to get comfortable on fast, a good fit if this is your first time on a quad or you just want simple, predictable handling on the coast road. Fully automatic, with the same locking cargo box and passenger seat as the rest of the fleet.',
    specs: ['Fully automatic', '1–2 riders', 'Front and rear racks', 'Locking cargo box'],
  },
];

const included = [
  'A helmet for every rider',
  'Full tank at pickup, return it full (fuel itself isn\'t included in the rate)',
  'Local route advice on where to ride',
  'Basic liability insurance',
  'Free delivery and collection in Santa Teresa',
  'Roadside help anywhere we rent',
  '4x4 storage box on every quad',
];

const bring = [
  "A valid driver's license from your home country: the physical card, not a photo",
  'Closed shoes (flip-flops are not safe on a quad)',
  'Sunglasses or eye protection',
  'A card or cash for the security deposit (from $500), refunded on return',
];
---

<BaseLayout
  title="ATV Rental Santa Teresa, Costa Rica | Rent ATV Santa Teresa"
  description="ATV rental in Santa Teresa, Costa Rica. Rent a fully automatic Can-Am, Honda or Kymco 4x4 quad by the day or week, from $50/day, with helmets and free hotel delivery."
  schema={schema}
>
  <Hero
    title="ATV Rental in Santa Teresa, Costa Rica"
    subtitle="Rent an ATV and see Santa Teresa your way. Santa Teresa's side roads and hill routes are unpaved, and a quad handles them better than anything else. Rent by the day, or keep one for your whole stay."
  />

  <!-- Stats: concrete numbers, the reference's "name counts directly" voice -->
  <section class="page-x section-y" aria-labelledby="stats">
    <h2 id="stats" class="sr-only">The fleet in numbers</h2>
    <StatBand
      stats={[
        { value: '4x4', label: 'Can-Am, Honda & Kymco' },
        { value: 'Automatic', label: 'No gears to learn' },
        { value: 'Locking box', label: 'On the back of every quad' },
        { value: '2 helmets', label: 'Provided with every rental' },
      ]}
    />
  </section>

  <!-- Dark contrast band: the fleet, shot in Santa Teresa -->
  <section class="band-dark" aria-labelledby="the-fleet">
    <div class="page-x section-y">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
        <div>
          <p class="eyebrow">The fleet</p>
          <h2 id="the-fleet" class="mt-2 text-h3 sm:text-h2">
            Every quad is fully automatic and fitted with a locking cargo box
          </h2>
          <p class="mt-4 text-base text-canvas/70">
            Three machines, not a mixed bag of whatever was cheapest — a Can-Am for
            the hills and green-season mud, a Honda for easy coast-road riding, and a
            Kymco for straightforward days on the flat. Every one gets a lockable top
            box for your bag and towels, and a passenger seat with a backrest so two
            people can ride comfortably.
          </p>
          <a href="#fleet" class="btn-primary mt-8">Compare the three quads</a>
        </div>
        <Photo
          name="fleet-canam-side"
          alt="Red Can-Am 450 4x4 ATV, part of our mixed fleet in Santa Teresa"
          sizes="(min-width: 1024px) 50vw, 100vw"
          ratio="4/3"
        />
      </div>
    </div>
  </section>

  <!-- Fleet detail -->
  <section id="fleet" class="page-x section-y" aria-labelledby="fleet-heading">
    <SectionHeading eyebrow="The fleet" title="Three machines, properly kept" subtitle="We run three models rather than whatever was cheapest, each picked for what it does well, and every one of them serviced between rentals, not once a season." />
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {fleet.map((quad) => (
        <article class="flex flex-col">
          <div class="photo-card">
            <Photo name={quad.photo} alt={quad.alt} />
          </div>
          <h3 class="mt-4 text-h4">{quad.name}</h3>
          <p class="mt-2 flex-1 text-base text-muted">{quad.body}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {quad.specs.map((spec) => (
              <li class="rounded-sm bg-surface px-3 py-1.5 text-body text-muted">{spec}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="mt-8 max-w-3xl text-base text-muted">
      Whichever machine you get, it is fully automatic, fitted with front and rear
      cargo racks and a locking box on the back, and serviced between rentals rather
      than once a season. Santa Teresa's combination of dust, salt air, rain, and
      rough tracks is hard on vehicles, and regular maintenance is the only thing
      that keeps any of them reliable.
    </p>
  </section>

  <!-- Why a quad -->
  <section class="band-sand" aria-labelledby="why-quad">
    <div class="page-x section-y">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
      <div>
        <SectionHeading eyebrow="Why a quad, not a car" title="The road is the reason" />
        <p class="mt-6 text-base text-muted">
          The main road through Santa Teresa is paved, but almost everything
          branching off it is not: side roads, hill routes, and the stretch
          toward Montezuma. In dry season those sections are washboard and
          dust; in green season they turn to mud with standing water at the
          low points. <a href="/blog/atv-vs-rental-car-in-santa-teresa-how-to-choose" class="link-inline">Rental cars</a> struggle with it, and the
          steep driveways up to the hillside villas are worse.
        </p>
        <p class="mt-4 text-base text-muted">
          A quad handles all of it, parks anywhere, and turns a fifteen-minute walk
          in the heat into a two-minute ride. It is the local answer, which is why
          you will see far more ATVs here than cars.
        </p>
        <p class="mt-4 text-base text-muted">
          Curious how visitors get around before they arrive? Read our guide to
          <a href="/blog/getting-around-santa-teresa" class="link-inline">getting around Santa Teresa</a>.
        </p>
        <a href="#rates" class="btn-secondary mt-8">See rental rates</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <Card icon="shield" title="Helmets for every rider" body="Included with every rental, in adult and youth sizes. Costa Rican law requires them on public roads." />
        <Card icon="wrench" title="Serviced between rentals" body="Every quad is checked, fuelled and cleaned before it goes out. If something fails on the road, we come to you." />
        <Card icon="pin" title="Local route advice" body="Tell us where you want to go and we will tell you what is worth it, what is rough right now, and what to skip after rain." />
        <Card icon="clock" title="Flexible pickup" body="Same-day rentals when we have quads free. Message in the morning and you can be riding by lunch." />
      </div>
    </div>
    <div class="mt-10">
      <Photo
        name="jungle-tunnel-road"
        alt="Unpaved jungle road near Santa Teresa, the kind of terrain a 4x4 quad is built for"
        sizes="100vw"
        ratio="16/9"
        class="rounded-media"
      />
    </div>
    </div>
  </section>

  <!-- Rates -->
  <section id="rates" class="page-x section-y" aria-labelledby="multi-day">
    <SectionHeading eyebrow="Staying a while?" title="Rates drop from three days" subtitle="Santa Teresa runs several kilometres along the coast, and many visitors stay for a week or longer. Longer rentals give you a better daily rate and make it easier to explore Santa Teresa and the surrounding areas without arranging transportation every day." />
    <div class="mt-8 grid gap-6 sm:grid-cols-4">
      {rates.map((tier) => (
        <InfoCard label={tier.label} value={`$${tier.price}/day`} detail={tier.detail} />
      ))}
    </div>
    <p class="mt-6 text-base text-muted">One security deposit covers the whole rental period regardless of length. If your quad develops a fault during your rental, we will bring a replacement rather than leave you without transportation. Full rates on the <a href="/pricing" class="link-inline">pricing page</a>.</p>
  </section>

  <!-- Included / bring -->
  <section id="included" class="band-sand section-y" aria-labelledby="whats-included">
    <div class="page-x">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <SectionHeading eyebrow="What you get" title="Included with every rental" />
          <p class="mt-3 text-base text-muted">There are no complicated pickup arrangements. Tell us where you are staying and we can bring the ATV directly to your hotel, Airbnb, or accommodation in Santa Teresa.</p>
          <ul class="mt-5 space-y-3">
            {included.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <SectionHeading eyebrow="What to bring" title="Turn up with these" />
          <p class="mt-3 text-base text-muted">If you are visiting Santa Teresa to surf, a small bag with your sunglasses, towel, water, and other essentials can easily fit in the cargo box.</p>
          <ul class="mt-5 space-y-3">
            {bring.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-ink-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" stroke-linecap="round" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Where you can get -->
  <section class="page-x section-y" aria-labelledby="where">
    <SectionHeading
      eyebrow="How far you can get"
      title="Rides worth taking"
      subtitle="Distances along the coast road from Santa Teresa, heading north."
    />
    <div class="mt-8">
      <RouteStrip />
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div>
        <Photo
          name="coast-road-beach"
          alt="Playa Carmen to Playa Hermosa coast road beach, Santa Teresa"
          sizes="(min-width: 768px) 33vw, 100vw"
          ratio="4/3"
          class="rounded-media"
        />
        <div class="mt-4">
          <Card title="The coast road" body="Playa Carmen up to Playa Hermosa and back. Flat, straightforward and stunning near sunset. The right first ride if you have never been on a quad." />
        </div>
      </div>
      <div>
        <Photo
          name="malpais-cove"
          alt="Quiet cove near Mal País and Cabo Blanco, Santa Teresa"
          sizes="(min-width: 768px) 33vw, 100vw"
          ratio="4/3"
          class="rounded-media"
        />
        <div class="mt-4">
          <Card title="Mal País and Cabo Blanco" body="South instead of north, through the fishing village at Mal País to the edge of Cabo Blanco reserve. Quieter road, good swimming stops along the way." />
        </div>
      </div>
      <div>
        <Photo
          name="manzanillo-headland"
          alt="Jungle-covered headland on the road toward Manzanillo, Santa Teresa"
          sizes="(min-width: 768px) 33vw, 100vw"
          ratio="4/3"
          class="rounded-media"
        />
        <div class="mt-4">
          <Card title="Manzanillo and the hills" body="Inland climbs, river crossings and long views back over the coast. Rough in places, and worth leaving until you have a day of riding behind you." />
        </div>
      </div>
    </div>
  </section>

  <!-- Surfers / taxi -->
  <section class="band-sand section-y" aria-labelledby="explore">
    <div class="page-x">
      <SectionHeading eyebrow="Explore Santa Teresa, Mal País, and beyond" title="Get more out of your time here" />
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="card">
          <h3 class="text-h4">ATV rental for surfers</h3>
          <p class="mt-3 text-base text-muted">Santa Teresa is a surf destination, and having your own transportation can make it easier to move between different beaches and surf spots. An ATV gives you the flexibility to check the waves in Santa Teresa, ride toward Playa Hermosa, or explore the coast around Mal País when conditions change. The locking cargo box also gives you useful storage for smaller personal items while you are getting around.</p>
        </div>
        <div class="card">
          <h3 class="text-h4">ATV rental vs. getting around by taxi</h3>
          <p class="mt-3 text-base text-muted"><a href="/blog/santa-teresa-atv-vs-taxi-which-is-better-for-getting-around" class="link-inline">Taxis and shuttles</a> are useful for individual trips, but the costs can add up when you are moving around Santa Teresa several times a day. With your own ATV, you can go to the beach whenever you want, pick up groceries, get to restaurants and surf spots, and carry your bags and beach gear without waiting for a ride.</p>
          <p class="mt-3 text-base text-muted">Not sure you need one at all? Read <a href="/blog/is-an-atv-necessary-for-getting-around-santa-teresa" class="link-inline">whether an ATV is necessary in Santa Teresa</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Delivery + map -->
  <section class="page-x section-y" aria-labelledby="visit-us">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12 lg:items-center">
      <div>
        <SectionHeading eyebrow="No pickup needed" title="We come to you" />
        <p class="mt-5 text-lead text-muted">
          You do not need to go anywhere. We deliver the ATV directly to your
          hotel, Airbnb, or wherever you are staying in Santa Teresa.
        </p>
        <ul class="mt-6 space-y-3 text-base text-ink-2">
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Free delivery to Santa Teresa, Mal País, Playa Carmen and Playa Hermosa — extra fee to Cóbano or Cabuya
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Available every day, 6:00am to 11:00pm
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            We collect from the same spot at the end of your rental
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Just send your hotel name when you book on WhatsApp
          </li>
        </ul>
        <dl class="mt-6 flex gap-8 border-t border-hairline pt-5">
          <div>
            <dt class="text-body text-muted">Phone / WhatsApp</dt>
            <dd class="mt-1 font-semibold text-ink-2">
              <a href={`tel:${site.phoneHref}`} class="link-list">{site.phoneDisplay}</a>
            </dd>
          </div>
          <div>
            <dt class="text-body text-muted">Hours</dt>
            <dd class="mt-1 font-semibold text-ink-2">Every day · 6am – 11pm</dd>
          </div>
        </dl>
      </div>

      <div>
        <div class="media-frame overflow-hidden" style="min-height:360px">
          <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d31476.47!2d-85.18!3d9.645!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f9fbb2e18f5bcb5%3A0x88c67a25b2e87ea2!2sSanta%20Teresa%2C%20Puntarenas%2C%20Costa%20Rica!5e0!3m2!1sen!2s!4v1724000000000!5m2!1sen!2s"
              width="100%"
              height="360"
              style="border:0; border-radius:20px; display:block;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Santa Teresa, Costa Rica — ATV rental delivery area"
            ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="page-x section-y" aria-labelledby="faq-heading">
    <SectionHeading eyebrow="Before you book" title="Common questions" />
    <div class="mt-8 max-w-3xl">
      <Faq items={faqs} />
    </div>
    <a href="/faq" class="link-inline mt-8 inline-block text-base">Read all questions</a>
  </section>

  <!-- Booking widget above the final CTA band -->
  <section id="book-now" class="page-x" aria-labelledby="book-widget">
    <h2 id="book-widget" class="sr-only">Book a quad</h2>
    <div class="mx-auto max-w-2xl">
      <BookingWidget />
    </div>
  </section>

  <CtaBand message="Hi! I'd like to check ATV availability in Santa Teresa." />

  <StickyCta message="Hi! I'd like to check ATV availability in Santa Teresa." />
</BaseLayout>
