---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import RouteStrip from '../components/RouteStrip.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Photo from '../components/Photo.astro';
import Photo from '../components/Photo.astro';
import StatBand from '../components/StatBand.astro';
import StickyCta from '../components/StickyCta.astro';
import { site } from '../data/site';
import { localBusinessSchema, websiteSchema, faqSchema } from '../data/schema';

const faqs = [
  {
    q: 'Do I need a licence to rent an ATV in Santa Teresa?',
    a: 'Yes. Costa Rican law requires a valid driver’s licence from your home country to operate an ATV on public roads. A standard car licence is enough — you do not need a motorcycle endorsement. Bring the physical licence, not a photo of it.',
  },
  {
    q: 'Can you deliver the ATV to my hotel?',
    a: 'Yes, and it is free anywhere in Santa Teresa, Playa Carmen and Mal País. We bring the quad to you, walk you through the controls and collect it from the same spot when your rental ends. Delivery further out to Manzanillo or Montezuma is available for a small fee.',
  },
  {
    q: 'Is insurance included?',
    a: 'Basic liability coverage is included in every rental. We will explain what it does and does not cover before you sign, so there are no surprises. Optional damage coverage is available if you would rather not carry the risk on the rougher inland trails.',
  },
  {
    q: 'What are the roads actually like?',
    a: 'The main coastal road is unpaved, rutted and very dusty in dry season, then soft and washed-out in green season. It is exactly why so many visitors ride quads here rather than drive. Inland routes toward Manzanillo include steep sections and river crossings that are best ridden with a guide.',
  },
];

const schema = [localBusinessSchema, websiteSchema, faqSchema(faqs)];
---

<BaseLayout
  title="ATV rentals in Santa Teresa, Costa Rica | Rent ATV Santa Teresa"
  description="Rent an ATV in Santa Teresa, Costa Rica. Self-drive quad rentals by the half day, day or week, with guided rides available. Free hotel delivery. Book on WhatsApp."
  schema={schema}
>
  <Hero
    title="The best way to see Santa Teresa is on four wheels"
    subtitle="Santa Teresa runs on a dirt road, and a quad handles it better than anything else. Rent by the day, ride with a guide, or keep one for your whole stay."
  />

  <!-- Stats: concrete numbers, the reference's "name counts directly" voice -->
  <section class="page-x section-y" aria-labelledby="stats">
    <h2 id="stats" class="sr-only">The fleet in numbers</h2>
    <StatBand
      stats={[
        { value: '450cc', label: 'Can-Am Outlander, 4x4' },
        { value: 'Automatic', label: 'No gears to learn' },
        { value: 'Locking box', label: 'On the back of every quad' },
        { value: '22 km', label: 'Coast road to Montezuma' },
      ]}
    />
  </section>

  <!-- Dark contrast band: the fleet, shot in Santa Teresa -->
  <section class="band-dark" aria-labelledby="the-fleet">
    <div class="page-x section-y">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
        <div>
          <p class="eyebrow">The fleet</p>
          <h2 id="the-fleet" class="mt-2 text-h3 sm:text-h2">
            Every quad is a Can-Am Outlander 450
          </h2>
          <p class="mt-4 text-base text-canvas/70">
            One machine, kept properly, rather than a mixed fleet of whatever was
            cheapest. Selectable 4x4 for the hills and green-season mud, a lockable
            top box for your bag and towels, and a passenger seat with a backrest so
            two people can ride comfortably.
          </p>
          <a href="/atv-rentals" class="btn-primary mt-8">See what's included</a>
        </div>
        <Photo
          name="fleet-line"
          alt="Four red Can-Am Outlander 450 ATVs with top boxes, parked and ready to rent in Santa Teresa"
          sizes="(min-width: 1024px) 50vw, 100vw"
          ratio="4/3"
        />
      </div>
    </div>
  </section>

  <!-- Why a quad -->
  <section class="page-x section-y" aria-labelledby="why-quad">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
      <div>
        <SectionHeading eyebrow="Why a quad, not a car" title="The road is the reason" />
        <p class="mt-6 text-base text-muted">
          There is one main road through Santa Teresa and it is not paved. In dry
          season it is washboard and dust; in green season it turns to mud with
          standing water at the low points. Rental cars struggle with it, and the
          steep driveways up to the hillside villas are worse.
        </p>
        <p class="mt-4 text-base text-muted">
          A quad handles all of it, parks anywhere, and turns a fifteen-minute walk
          in the heat into a two-minute ride. It is the local answer, which is why
          you will see far more ATVs here than cars.
        </p>
        <a href="/atv-rentals" class="btn-secondary mt-8">See rental options</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <Card icon="shield" title="Helmets for every rider" body="Included with every rental, in adult and youth sizes. Costa Rican law requires them on public roads." />
        <Card icon="wrench" title="Serviced between rentals" body="Every quad is checked, fuelled and cleaned before it goes out. If something fails on the road, we come to you." />
        <Card icon="pin" title="Route map included" body="A marked map of the good rides, the places worth stopping, and the sections to avoid after rain." />
        <Card icon="clock" title="Flexible pickup" body="Same-day rentals when we have quads free. Message in the morning and you can be riding by lunch." />
      </div>
    </div>
  </section>

  <PhotoBand
    eyebrow="The fleet"
    title="Can-Am Outlander 450 4x4"
    body="One machine, kept properly. Fully automatic, real 4x4 for the hills and green-season mud, front and rear racks, and a locking box on the back for bags, towels and shoes."
  />

  <!-- Where you can get -->
  <section class="page-x section-y" aria-labelledby="where">
    <SectionHeading
      eyebrow="How far you can get"
      title="Rides worth taking"
      subtitle="Distances along the coast road from Playa Carmen, heading north."
    />
    <div class="mt-8">
      <RouteStrip />
    </div>
    <div class="mt-8">
      <Photo
        name="quad-side-wide"
        alt="Can-Am Outlander 450 with rear top box, side view, parked in Santa Teresa"
        sizes="100vw"
        widths={[800, 1600]}
        ratio="3/2"
      />
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <Card title="The coast road" body="Playa Carmen up to Playa Hermosa and back. Flat, straightforward and stunning near sunset. The right first ride if you have never been on a quad." />
      <Card title="Mal País and Cabo Blanco" body="South instead of north, through the fishing village at Mal País to the edge of Cabo Blanco reserve. Quieter road, good swimming stops along the way." />
      <Card title="Manzanillo and the hills" body="Inland climbs, river crossings and long views back over the coast. Rough in places, and better ridden with a guide — ask us when you book." />
    </div>
  </section>

  <!-- Photos -->
  <section class="page-x section-y" aria-labelledby="gallery">
    <SectionHeading eyebrow="What you are getting" title="The actual machine" />
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      <Photo name="quad-side" alt="Side view of a red Can-Am Outlander 450 showing the rear cargo box and 4x4 badge" />
      <Photo name="quad-front" alt="Front view of a red Can-Am Outlander 450 with brush guard and front rack" />
      <Photo name="fleet-line" alt="Red Can-Am Outlander quads lined up ready for rental in Santa Teresa" />
    </div>
  </section>

  <!-- Visit us -->
  <section class="page-x section-y" aria-labelledby="visit-us">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div>
        <SectionHeading eyebrow="Find us" title="Where to pick up" />
        <address class="mt-6 space-y-1 text-base not-italic text-muted">
          <span class="block font-semibold text-ink-2">{site.name}</span>
          <span class="block">{site.address.street}</span>
          <span class="block">{site.address.locality}, {site.address.region}, {site.address.countryName}</span>
        </address>
        <dl class="mt-6 space-y-3 text-base">
          <div class="flex gap-4">
            <dt class="w-24 shrink-0 text-muted">Phone</dt>
            <dd><a href={`tel:${site.phoneHref}`} class="link-list">{site.phoneDisplay}</a></dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-24 shrink-0 text-muted">Email</dt>
            <dd><a href={`mailto:${site.email}`} class="link-list">{site.email}</a></dd>
          </div>
          {site.hours.map((block) => (
            <div class="flex gap-4">
              <dt class="w-24 shrink-0 text-muted">{block.label.split(' ')[0]}</dt>
              <dd>{block.label} · {block.time}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-6 text-base text-muted">
          Not near the shop? We deliver free to hotels in Santa Teresa, Playa Carmen
          and Mal País — just send your hotel name when you book.
        </p>
      </div>

      <div>
        <Photo
          name="quad-front"
          alt="Front view of a Can-Am Outlander 450 ATV available for rent in Santa Teresa"
          sizes="(min-width: 1024px) 50vw, 100vw"
          ratio="4/3"
        />
        <!-- PLACEHOLDER — swap for a Google Map embed once the pin is confirmed -->
        <p class="mt-3 text-body text-muted">Map embed goes here once the pickup pin is set.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="page-x section-y" aria-labelledby="faq-heading">
    <SectionHeading eyebrow="Before you book" title="Common questions" />
    <div class="mt-8 max-w-3xl">
      <Faq items={faqs} />
    </div>
    <a href="/faq" class="link-inline mt-8 inline-block text-base">Read all questions</a>
  </section>

  <CtaBand message="Hi! I'd like to check ATV availability in Santa Teresa." />

  <StickyCta message="Hi! I'd like to check ATV availability in Santa Teresa." />
</BaseLayout>
