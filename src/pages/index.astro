---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import RouteStrip from '../components/RouteStrip.astro';
import BookingWidget from '../components/BookingWidget.astro';
import Photo from '../components/Photo.astro';
import StatBand from '../components/StatBand.astro';
import StickyCta from '../components/StickyCta.astro';
import InfoCard from '../components/InfoCard.astro';
import { site, atvFleet, atvFromRate, atvDailyRate, weeklyDiscount, utvFleet, atvTours } from '../data/site';
import { localBusinessSchema, websiteSchema, faqSchema, serviceSchema } from '../data/schema';

const faqs = [
  {
    q: 'Do I need a licence to rent an ATV in Santa Teresa?',
    a: 'Yes. Costa Rican law requires a valid driver’s licence from your home country to operate an ATV on public roads. A standard car licence is enough — you do not need a motorcycle endorsement. Bring the physical licence, not a photo of it.',
  },
  {
    q: 'Can you deliver the ATV to my hotel?',
    a: 'Yes, and it is free anywhere in Santa Teresa, Mal País, Playa Carmen and Playa Hermosa. We bring the quad to you, walk you through the controls and collect it from the same spot when your rental ends. Delivery to Cóbano or Cabuya is available for an extra fee.',
  },
  {
    q: 'Is insurance included?',
    a: 'Basic liability coverage is included in every rental. We will explain what it does and does not cover before you sign, so there are no surprises. Optional damage coverage is available if you would rather not carry the risk on the rougher inland trails.',
  },
  {
    q: 'What are the roads actually like?',
    a: 'The main coastal road through Santa Teresa is paved, but the side roads, hill routes, and the stretch toward Montezuma are unpaved and can get rutted and dusty in dry season, then soft and washed-out in green season. It is exactly why so many visitors ride quads here rather than drive. Inland routes toward Manzanillo include steep sections and river crossings, so ask us about current conditions before heading that way.',
  },
  { q: 'Can two people ride one ATV?', a: 'Yes. Every quad in our fleet can accommodate one or two riders.' },
  { q: 'Can I ride to Montezuma?', a: 'Yes. It is approximately 22 km and takes around 50 minutes depending on conditions.' },
  { q: 'Is fuel included?', a: 'The tank is full when you pick up and is expected to come back full. Fuel itself is not included in the rental price, but you always start with a full tank.' },
  { q: 'Are helmets included?', a: 'Yes. One helmet per rider, included with every rental.' },
  { q: 'Can I rent for a week?', a: 'Yes. Rentals over 7 days get 10% off the daily rate.' },
  { q: 'Do you rent UTVs or side-by-sides?', a: `Yes. We rent 1000cc side-by-sides that seat 4 or 5 people, from $${Math.min(...utvFleet.map((u) => u.rate8h))} for 8 hours. Every ATV carries up to two riders, so a side-by-side is the easier option for families and groups.` },
  { q: 'Do you offer guided ATV tours?', a: `Yes. A half-day guided tour to the Montezuma waterfalls costs $${atvTours[0].price} per ATV (1 or 2 riders), and a full-day tour to three waterfalls costs $${atvTours[1].price} per ATV.` },
  { q: 'What is the minimum age to rent an ATV?', a: 'You must be 18 or over to drive. Younger passengers can ride behind an adult driver, and youth helmets are available.' },
  { q: 'Do you offer airport shuttles to Santa Teresa?', a: 'No. We rent ATVs, not transfers. Book a shuttle, the Puntarenas–Paquera ferry or a flight into Tambor, then send us your hotel name and the quad can be delivered when you arrive.' },
];

const schema = [
  localBusinessSchema,
  websiteSchema,
  serviceSchema({
    name: 'ATV rental in Santa Teresa, Costa Rica',
    description:
      `Rent an ATV in Santa Teresa, Costa Rica: Kymco 300cc, Honda 420cc or Yamaha 450cc. Helmets and free hotel delivery included, full tank at pickup. From $${atvFromRate}/day, ${weeklyDiscount.percent}% off over 7 days.`,
    url: site.url,
    offers: atvFleet.map((q) => ({ price: q.rate24h, description: `${q.name} ATV, 24-hour rate` })),
  }),
  faqSchema(faqs),
];

// Copy per machine; rates, engine and transmission come from atvFleet in site.ts.
const fleetCopy: Record<string, string> = {
  kymco: 'The Kymco is straightforward and quick to get comfortable on, a good fit if this is your first time on a quad or you just want simple, predictable handling on the coast road. Fully automatic: throttle, brake and steering, nothing else to think about.',
  honda: 'The Honda is reliable and has more pull than the Kymco. It is semi-automatic: you change gear with a foot shifter, but there is no clutch lever, so it takes a few minutes to get used to. A good pick if you have ridden a motorbike or quad before.',
  yamaha: 'The Yamaha is the most powerful quad we rent and fully automatic, so you get the extra muscle for the hill roads, the stretch to Manzanillo and the muddy green-season sections without having to shift.',
};
const fleet = atvFleet.map((q) => ({
  ...q,
  body: fleetCopy[q.id],
  specs: [q.engine, q.transmission, '1–2 riders', 'Locking cargo box'],
}));

const gallery = [
  { photo: 'marazul-rocks-sunset', alt: 'Sunset over the rocks at low tide on Mar Azul beach, near Santa Teresa' },
  { photo: 'marazul-reflection-sunset', alt: 'An orange sunset reflected in wet sand at Mar Azul' },
  { photo: 'marazul-canopy-sunset', alt: 'Footprints in the sand under the trees at Mar Azul in late-afternoon light' },
  { photo: 'headland-beach-quiet', alt: 'An empty beach below a jungle-covered headland on the southern Nicoya Peninsula' },
  { photo: 'palm-beach-cloudy', alt: 'Palm trees at the top of a quiet beach near Santa Teresa on a cloudy afternoon' },
  { photo: 'rock-from-water', alt: 'A rock outcrop seen from the water off the coast near Santa Teresa' },
  { photo: 'headland-from-water', alt: 'The coastline and a jungle headland seen from the water under green-season clouds' },
  { photo: 'main-street-paved', alt: 'The paved main street through Santa Teresa, lined with palms and parked motorbikes' },
  { photo: 'gravel-road-junction', alt: 'A gravel side road junction in Santa Teresa with potholes and loose surface' },
];

const included = [
  'A helmet for every rider',
  'Full tank at pickup, return it full (fuel itself isn\'t included in the rate)',
  'Local route advice on where to ride',
  'Basic liability insurance',
  'Free delivery and collection in Santa Teresa',
  'Roadside help anywhere we rent',
  'Locking storage box on every quad',
];

const bring = [
  "A valid driver's license from your home country: the physical card, not a photo",
  'Closed shoes (flip-flops are not safe on a quad)',
  'Sunglasses or eye protection',
  'A card or cash for the security deposit (from $500), refunded on return',
];
---

<BaseLayout
  title="ATV Rental Santa Teresa, Costa Rica | Rent ATV Santa Teresa"
  description={`ATV rental in Santa Teresa, Costa Rica. Rent a Kymco, Honda or Yamaha quad for 8 hours, a day or a week, from $${atvFromRate}/day, with helmets and free hotel delivery. Side-by-sides and guided tours too.`}
  schema={schema}
>
  <Hero
    title="ATV Rental in Santa Teresa, Costa Rica"
    subtitle="Rent an ATV and see Santa Teresa your way. Santa Teresa's side roads and hill routes are unpaved, and a quad handles them better than anything else. Rent by the day, or keep one for your whole stay."
  />

  <!-- Stats: concrete numbers, the reference's "name counts directly" voice -->
  <section class="page-x section-y" aria-labelledby="stats">
    <h2 id="stats" class="sr-only">The fleet in numbers</h2>
    <StatBand
      stats={[
        { value: '300–450cc', label: 'Kymco, Honda & Yamaha' },
        { value: '8h or 24h', label: 'Rent for the day or longer' },
        { value: 'Locking box', label: 'On the back of every quad' },
        { value: '2 helmets', label: 'Provided with every rental' },
      ]}
    />
  </section>

  <!-- Dark contrast band: the fleet, shot in Santa Teresa -->
  <section class="band-dark" aria-labelledby="the-fleet">
    <div class="page-x section-y">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
        <div>
          <p class="eyebrow">The fleet</p>
          <h2 id="the-fleet" class="mt-2 text-h3 sm:text-h2">
            Three quads, each with a locking cargo box and room for two
          </h2>
          <p class="mt-4 text-base text-canvas/70">
            Three machines, not a mixed bag of whatever was cheapest: a fully
            automatic Kymco for easy days on the flat, a semi-automatic Honda for
            riders who want more pull, and a fully automatic Yamaha 450 for the hills
            and green-season mud. Every one gets a lockable top box for your bag and
            towels, and a passenger seat so two people can ride comfortably.
          </p>
          <a href="#fleet" class="btn-primary mt-8">Compare the three quads</a>
        </div>
        <Photo
          name="atv-beach-sunset"
          alt="A red quad with a cargo box parked under the trees at Mar Azul beach at sunset"
          sizes="(min-width: 1024px) 50vw, 100vw"
          ratio="4/3"
        />
      </div>
    </div>
  </section>

  <!-- Fleet detail -->
  <section id="fleet" class="page-x section-y" aria-labelledby="fleet-heading">
    <SectionHeading eyebrow="The fleet" title="Three machines, properly kept" subtitle="We run three models rather than whatever was cheapest, each picked for what it does well, and every one of them serviced between rentals, not once a season." />
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {fleet.map((quad) => (
        <article class="flex flex-col">
          <div class="photo-card">
            <Photo name={quad.photo} alt={quad.alt} />
          </div>
          <h3 class="mt-4 text-h4">{quad.name}</h3>
          <p class="mt-1 text-body font-semibold text-ink-2">${quad.rate24h} per 24 hours · ${quad.rate8h} for 8 hours</p>
          <p class="mt-2 flex-1 text-base text-muted">{quad.body}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {quad.specs.map((spec) => (
              <li class="rounded-sm bg-surface px-3 py-1.5 text-body text-muted">{spec}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="mt-8 max-w-3xl text-base text-muted">
      Whichever machine you get, it is fitted with cargo racks and a locking box
      on the back, and serviced between rentals rather
      than once a season. Santa Teresa's combination of dust, salt air, rain, and
      rough tracks is hard on vehicles, and regular maintenance is the only thing
      that keeps any of them reliable.
    </p>

    <!-- Side-by-side comparison: the scannable version of the cards above -->
    <h3 id="compare-quads" class="mt-12 text-h4">Compare the ATV rentals in Santa Teresa</h3>
    <div class="mt-4 overflow-x-auto rounded-media border border-hairline">
      <table class="w-full min-w-[640px] border-collapse text-left text-base">
        <caption class="sr-only">Comparison of the three ATV models available to rent in Santa Teresa</caption>
        <thead class="bg-surface text-body text-muted">
          <tr>
            {['Quad', 'Best for', 'Gears', 'Riders', '8 hours', '24 hours'].map((h) => (
              <th scope="col" class="px-4 py-3 font-semibold">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {atvFleet.map((row) => (
            <tr class="border-t border-hairline align-top">
              <th scope="row" class="px-4 py-3 font-semibold text-ink-2">{row.name}</th>
              <td class="px-4 py-3 text-muted">{row.bestFor}</td>
              <td class="px-4 py-3 text-muted">{row.transmission}</td>
              <td class="px-4 py-3 text-muted">1–2</td>
              <td class="px-4 py-3 text-muted">${row.rate8h}</td>
              <td class="px-4 py-3 text-muted">${row.rate24h}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-body text-muted">
      {`Rentals over 7 days get ${weeklyDiscount.percent}% off every day. The security deposit, from $500, varies by quad.`}
      Travelling as a group of 3 to 5? <a href="/utv-rentals-santa-teresa" class="link-inline">Rent a side-by-side (UTV)</a> instead,
      or let a local guide lead the way on an <a href="/atv-tours-santa-teresa" class="link-inline">ATV tour to the Montezuma waterfalls</a>.
    </p>
  </section>

  <!-- Why a quad -->
  <section class="band-sand" aria-labelledby="why-quad">
    <div class="page-x section-y">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
      <div>
        <SectionHeading eyebrow="Why a quad, not a car" title="The road is the reason" />
        <p class="mt-6 text-base text-muted">
          The main road through Santa Teresa is paved, but almost everything
          branching off it is not: side roads, hill routes, and the stretch
          toward Montezuma. In dry season those sections are washboard and
          dust; in green season they turn to mud with standing water at the
          low points. <a href="/blog/atv-vs-rental-car-in-santa-teresa-how-to-choose" class="link-inline">Rental cars</a> struggle with it, and the
          steep driveways up to the hillside villas are worse.
        </p>
        <p class="mt-4 text-base text-muted">
          A quad handles all of it, parks anywhere, and turns a fifteen-minute walk
          in the heat into a two-minute ride. It is the local answer, which is why
          you will see far more ATVs here than cars.
        </p>
        <p class="mt-4 text-base text-muted">
          Curious how visitors get around before they arrive? Read our guide to
          <a href="/blog/getting-around-santa-teresa" class="link-inline">getting around Santa Teresa</a>.
        </p>
        <a href="#rates" class="btn-secondary mt-8">See rental rates</a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <Card icon="shield" title="Helmets for every rider" body="Included with every rental, in adult and youth sizes. Costa Rican law requires them on public roads." />
        <Card icon="wrench" title="Serviced between rentals" body="Every quad is checked, fuelled and cleaned before it goes out. If something fails on the road, we come to you." />
        <Card icon="pin" title="Local route advice" body="Tell us where you want to go and we will tell you what is worth it, what is rough right now, and what to skip after rain." />
        <Card icon="clock" title="Flexible pickup" body="Same-day rentals when we have quads free. Message in the morning and you can be riding by lunch." />
      </div>
    </div>
    <div class="mt-10">
      <Photo
        name="side-road-wide"
        alt="A potholed dirt side road off the main street in Santa Teresa, the kind of surface a 4x4 quad is built for"
        sizes="100vw"
        ratio="16/9"
        class="rounded-media"
      />
    </div>
    </div>
  </section>

  <!-- Rates -->
  <section id="rates" class="page-x section-y" aria-labelledby="multi-day">
    <SectionHeading eyebrow="Staying a while?" title="10% off rentals over a week" subtitle="Santa Teresa runs several kilometres along the coast, and many visitors stay for a week or longer. Longer rentals give you a better daily rate and make it easier to explore Santa Teresa and the surrounding areas without arranging transportation every day." />
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {atvFleet.map((q) => (
        <InfoCard label={q.name} value={`$${q.rate24h}/day`} detail={`$${atvDailyRate(q.rate24h, weeklyDiscount.minDays)}/day over 7 days · $${q.rate8h} for 8 hours`} />
      ))}
    </div>
    <p class="mt-6 text-base text-muted">One security deposit covers the whole rental period regardless of length. If your quad develops a fault during your rental, we will bring a replacement rather than leave you without transportation. Full rates on the <a href="/pricing" class="link-inline">pricing page</a>.</p>
  </section>

  <!-- Included / bring -->
  <section id="included" class="band-sand section-y" aria-labelledby="whats-included">
    <div class="page-x">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <SectionHeading eyebrow="What you get" title="Included with every rental" />
          <p class="mt-3 text-base text-muted">There are no complicated pickup arrangements. Tell us where you are staying and we can bring the ATV directly to your hotel, Airbnb, or accommodation in Santa Teresa.</p>
          <ul class="mt-5 space-y-3">
            {included.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <SectionHeading eyebrow="What to bring" title="Turn up with these" />
          <p class="mt-3 text-base text-muted">If you are visiting Santa Teresa to surf, a small bag with your sunglasses, towel, water, and other essentials can easily fit in the cargo box.</p>
          <ul class="mt-5 space-y-3">
            {bring.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-ink-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" stroke-linecap="round" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Rules and seasons: the practical detail competitors cover and we didn't -->
  <section class="page-x section-y" aria-labelledby="before-you-ride">
    <SectionHeading
      eyebrow="Before you ride"
      title="Rental rules and riding seasons"
      subtitle="What renting an ATV in Santa Teresa actually involves, so nothing at pickup is a surprise."
    />
    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="card">
        <h3 class="text-h4">The rental rules</h3>
        <ul class="mt-4 space-y-3 text-base text-muted">
          <li><strong class="text-ink-2">Minimum age:</strong> 18 to drive. Younger passengers can ride behind an adult, with a youth helmet.</li>
          <li><strong class="text-ink-2">Licence:</strong> a valid car licence from your home country, carried with you. No motorcycle endorsement needed.</li>
          <li><strong class="text-ink-2">Deposit:</strong> from $500 on card or in cash, one deposit for the whole rental, returned when the quad is collected.</li>
          <li><strong class="text-ink-2">Insurance:</strong> basic liability is included. Optional damage cover is available per day and reduces what you owe if the quad comes back damaged.</li>
          <li><strong class="text-ink-2">Riders:</strong> up to two people on every ATV. You can share the driving; just add everyone who will drive to the rental agreement.</li>
          <li><strong class="text-ink-2">Fuel:</strong> full tank at pickup, full tank back. A refuelling charge comes off the deposit otherwise.</li>
          <li><strong class="text-ink-2">Riding:</strong> helmets on, no alcohol, no protected beach sections or turtle nesting areas, and back before dark.</li>
        </ul>
        <p class="mt-4 text-body text-muted">Full details are in the <a href="/terms-and-conditions" class="link-inline">rental terms</a> and the <a href="/faq" class="link-inline">FAQ</a>.</p>
      </div>
      <div class="card">
        <h3 class="text-h4">Dry season vs. green season</h3>
        <p class="mt-4 text-base text-muted"><strong class="text-ink-2">Dry season, roughly December to April,</strong> is high season on the Nicoya Peninsula. The dirt roads turn to washboard and dust, sunglasses stop being optional, and quads book out around Christmas and Easter, so message a few days ahead.</p>
        <p class="mt-4 text-base text-muted"><strong class="text-ink-2">Green season, roughly May to November,</strong> brings afternoon rain. Side roads soften, low points hold water, and the river crossings toward Manzanillo can run deep after a storm. Ride in the morning, and ask us what is passable that week.</p>
        <p class="mt-4 text-base text-muted">Whatever the month, plan to be back before sunset, around 5:30pm. The roads are unlit and animals are hard to see after dark. For the tide pools at Mal País, time the ride for low tide: our <a href="/blog/mal-pais-tide-pools-atv" class="link-inline">tide pool guide</a> explains how.</p>
      </div>
    </div>
  </section>

  <!-- Where you can get -->
  <section class="page-x section-y" aria-labelledby="where">
    <SectionHeading
      eyebrow="How far you can get"
      title="Rides worth taking"
      subtitle="Distances along the coast road from Santa Teresa, heading north."
    />
    <div class="mt-8">
      <RouteStrip />
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div>
        <Photo
          name="coast-road-beach"
          alt="Playa Carmen to Playa Hermosa coast road beach, Santa Teresa"
          sizes="(min-width: 768px) 33vw, 100vw"
          ratio="4/3"
          class="rounded-media"
        />
        <div class="mt-4">
          <Card title="The coast road" body="Playa Carmen up to Playa Hermosa and back. Flat, straightforward and stunning near sunset. The right first ride if you have never been on a quad." />
        </div>
      </div>
      <div>
        <Photo
          name="malpais-tidepools-sunset"
          alt="Low-tide rock pools at sunset on the coast south of Santa Teresa toward Mal País"
          sizes="(min-width: 768px) 33vw, 100vw"
          ratio="4/3"
          class="rounded-media"
        />
        <div class="mt-4">
          <Card title="Mal País and Cabo Blanco" body="South instead of north, through the fishing village at Mal País to the edge of Cabo Blanco reserve. Quieter road, good swimming stops along the way." />
        </div>
      </div>
      <div>
        <Photo
          name="manzanillo-headland"
          alt="Jungle-covered headland on the road toward Manzanillo, Santa Teresa"
          sizes="(min-width: 768px) 33vw, 100vw"
          ratio="4/3"
          class="rounded-media"
        />
        <div class="mt-4">
          <Card title="Manzanillo and the hills" body="Inland climbs, river crossings and long views back over the coast. Rough in places, and worth leaving until you have a day of riding behind you." />
        </div>
      </div>
    </div>
    <p class="mt-8 max-w-3xl text-base text-muted">
      From Playa Santa Teresa you can ride north to <a href="/blog/playa-hermosa-atv-santa-teresa" class="link-inline">Playa Hermosa</a> and
      <a href="/blog/manzanillo-beach-atv-santa-teresa" class="link-inline">Playa Manzanillo</a>, south through Mal País to the edge of the
      <a href="/blog/cabo-blanco-reserve-atv" class="link-inline">Cabo Blanco reserve</a>, or inland over the hills to the
      <a href="/blog/montezuma-waterfall-atv-santa-teresa" class="link-inline">Montezuma waterfall</a>. Each guide covers the route, the road
      surface and how long the ride takes.
    </p>
  </section>

  <!-- Photo gallery: shot on rides around Santa Teresa -->
  <section id="gallery" class="page-x section-y pt-0" aria-label="Photos from rides around Santa Teresa">
    <SectionHeading eyebrow="Out on the quad" title="What a day of riding looks like" subtitle="Beaches, back roads and sunsets from rides around Santa Teresa and Mar Azul." />
    <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {gallery.map((shot, i) => (
        <Photo
          name={shot.photo}
          alt={shot.alt}
          sizes={i === 0 ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw'}
          ratio="4/3"
          class:list={['rounded-media', i === 0 && 'col-span-2 lg:row-span-2']}
        />
      ))}
    </div>
  </section>

  <!-- Surfers / taxi -->
  <section class="band-sand section-y" aria-labelledby="explore">
    <div class="page-x">
      <SectionHeading eyebrow="Explore Santa Teresa, Mal País, and beyond" title="Get more out of your time here" />
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="card">
          <h3 class="text-h4">ATV rental for surfers</h3>
          <p class="mt-3 text-base text-muted">Santa Teresa is a surf destination, and having your own transportation can make it easier to move between <a href="/blog/exploring-santa-teresa-beaches-by-atv-safely" class="link-inline">different beaches and surf spots</a>. An ATV gives you the flexibility to check the waves in Santa Teresa, ride toward Playa Hermosa, or explore the coast around Mal País when conditions change. The locking cargo box also gives you useful storage for smaller personal items while you are getting around.</p>
        </div>
        <div class="card">
          <h3 class="text-h4">ATV rental vs. getting around by taxi</h3>
          <p class="mt-3 text-base text-muted"><a href="/blog/santa-teresa-atv-vs-taxi-which-is-better-for-getting-around" class="link-inline">Taxis and shuttles</a> are useful for individual trips, but the costs can add up when you are moving around Santa Teresa several times a day. With your own ATV, you can go to the beach whenever you want, pick up groceries, get to restaurants and surf spots, and carry your bags and beach gear without waiting for a ride.</p>
          <p class="mt-3 text-base text-muted">Not sure you need one at all? Read <a href="/blog/is-an-atv-necessary-for-getting-around-santa-teresa" class="link-inline">whether an ATV is necessary in Santa Teresa</a>.</p>
        </div>
        <div class="card">
          <h3 class="text-h4">Getting to Santa Teresa, then onto a quad</h3>
          <p class="mt-3 text-base text-muted">Santa Teresa sits near the southern tip of the Nicoya Peninsula. Most visitors arrive by shared or private shuttle from San José or Liberia, by the car ferry from Puntarenas to Paquera, or on a short domestic flight into Tambor. We rent ATVs rather than run airport transfers, so book your shuttle or flight to Santa Teresa, then send us your hotel name on WhatsApp and the quad can be waiting when you arrive.</p>
        </div>
        <div class="card">
          <h3 class="text-h4">What makes Santa Teresa worth riding</h3>
          <p class="mt-3 text-base text-muted">The town is a string of surf breaks, cafés and guesthouses spread along several kilometres of coast, with Mal País to the south and Playa Carmen, Playa Hermosa and Manzanillo to the north. Very little of it is walkable in the heat, and most of the side roads are dirt. That spread-out layout, plus the beaches and jungle headlands within half an hour's ride, is why a quad is the way most people here get around.</p>
        </div>
      </div>
    </div>
  </section>

