---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import RouteStrip from '../components/RouteStrip.astro';
import BookingWidget from '../components/BookingWidget.astro';
import InfoCard from '../components/InfoCard.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import { serviceSchema } from '../data/schema';

const schema = serviceSchema({
  name: 'ATV rentals in Santa Teresa',
  description:
    'Self-drive ATV rentals in Santa Teresa, Costa Rica by the half day, day or week. Fully automatic with 4x4 storage box. Helmets and free hotel delivery included.',
  url: `${site.url}/atv-rentals`,
});

const fleet = [
  {
    photo: 'quad-angle',
    alt: 'Red Can-Am Outlander 450 4x4 at an angle showing front rack, seat and rear cargo box',
    name: 'Can-Am Outlander 450 4x4',
    body: 'Our whole fleet is the same machine, so there is no guessing about what you will be handed. Fully automatic, selectable 4x4, and enough ground clearance for the hill roads and green-season mud.',
    specs: ['Fully automatic', 'Selectable 4x4', '1-2 riders'],
  },
  {
    photo: 'quad-side',
    alt: 'Side view of the Can-Am Outlander 450 showing the locking rear cargo box',
    name: 'Locking cargo box',
    body: 'A hard box on the back of every quad, plus front and rear racks. Bags, towels, groceries and wet shoes go in it, which is the difference between a quad you can run errands on and one you cannot.',
    specs: ['Lockable', 'Front + rear racks', 'Fits daypacks'],
  },
  {
    photo: 'quad-front',
    alt: 'Front view of the Can-Am Outlander 450 showing brush guard and headlights',
    name: 'Set up for these roads',
    body: 'Brush guard, mirrors and working lights on every machine. Serviced between rentals rather than once a season, because the dust and salt air here are hard on everything.',
    specs: ['Brush guard', 'Mirrors', 'Serviced each rental'],
  },
];

const included = [
  'A helmet for every rider',
  'Full tank of fuel at pickup',
  'Marked route map of the area',
  'Basic liability insurance',
  'Free delivery and collection in Santa Teresa',
  'Roadside help anywhere we rent',
  '4x4 storage box on every quad',
];

const bring = [
  'A valid driver license from your home country - the physical card, not a photo',
  'Closed shoes. Flip-flops are not safe on a quad and we cannot rent to you in them',
  'Sunglasses or eye protection - the road is very dusty in dry season',
  'A card or cash for the security deposit, refunded on return',
];
---

<BaseLayout
  title="ATV rentals in Santa Teresa | Self-drive quad hire | Rent ATV Santa Teresa"
  description="Self-drive ATV rentals in Santa Teresa, Costa Rica. Fully automatic quads with 4x4 storage box, helmets, route map, insurance and free hotel delivery included."
  schema={schema}
>
  <Breadcrumb items={[{ label: 'ATV rentals', href: '/atv-rentals' }]} />

  <!-- Hero: headline left, booking widget right -->
  <section class="page-x section-y" aria-labelledby="rentals-hero">
    <div class="grid items-start gap-8 lg:grid-cols-[5fr_6fr] lg:gap-12">

      <!-- Left: copy -->
      <div>
        <p class="eyebrow rule-marque">Self-drive · Santa Teresa</p>
        <h1 id="rentals-hero" class="mt-4 text-h2 sm:text-h1">
          ATV rentals in Santa Teresa
        </h1>
        <p class="mt-5 max-w-lg text-lead text-muted">
          Take the keys and go. All our quads are fully automatic with a
          locking 4x4 cargo box. Helmets, fuel and a route map included.
          Free delivery to your hotel.
        </p>

        <!-- Quick spec chips -->
        <ul class="mt-6 flex flex-wrap gap-2">
          {[
            'Can-Am Outlander 450',
            'Fully automatic',
            '4x4 selectable',
            'Locking cargo box',
            'Free delivery',
            'Helmets included',
          ].map((s) => (
            <li class="rounded-sm bg-surface px-3 py-1.5 text-body text-muted">{s}</li>
          ))}
        </ul>

        <!-- Pricing anchor so they know the number before opening the widget -->
        <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-t border-hairline pt-5">
          <div>
            <dt class="text-body text-muted">From</dt>
            <dd class="stat-num">$50<span class="text-h4 font-normal text-muted">/day</span></dd>
          </div>
          <div>
            <dt class="text-body text-muted">Delivery</dt>
            <dd class="stat-num">Free</dd>
          </div>
          <div>
            <dt class="text-body text-muted">Riders</dt>
            <dd class="stat-num">1–2</dd>
          </div>
        </dl>
      </div>

      <!-- Right: booking widget -->
      <div>
        <BookingWidget />
      </div>

    </div>
  </section>

  <section class="page-x section-y" aria-labelledby="fleet">
    <SectionHeading
      eyebrow="The fleet"
      title="One machine, properly kept"
      subtitle="We run a single model rather than a mixed fleet, so every rental is the same known quantity and the parts we stock fit every machine."
    />
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {fleet.map((quad) => (
        <article class="flex flex-col">
          <div class="photo-card">
            <Photo name={quad.photo} alt={quad.alt} />
          </div>
          <h3 class="mt-4 text-h4">{quad.name}</h3>
          <p class="mt-2 flex-1 text-base text-muted">{quad.body}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {quad.specs.map((spec) => (
              <li class="rounded-sm bg-surface px-3 py-1.5 text-body text-muted">{spec}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="band-sand section-y" aria-labelledby="whats-included">
    <div class="page-x">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <SectionHeading eyebrow="What you get" title="Included with every rental" />
          <ul class="mt-6 space-y-3">
            {included.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-ink-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M4 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <SectionHeading eyebrow="What to bring" title="Turn up with these" />
          <ul class="mt-6 space-y-3">
            {bring.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-ink-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 8v4M12 16h.01" stroke-linecap="round" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="page-x section-y" aria-labelledby="multi-day">
    <SectionHeading
      eyebrow="Staying a while"
      title="Rates drop from three days"
      subtitle="Santa Teresa runs several kilometres along one road. If you are here for a week, renting day by day is the expensive way to do it."
    />
    <div class="mt-8 grid gap-6 sm:grid-cols-4">
      <InfoCard label="Under 3 days" value="$65/day" detail="Half-day and full-day rentals" />
      <InfoCard label="3 to 7 days" value="$60/day" detail="The most popular range" />
      <InfoCard label="Over 7 days" value="$55/day" detail="Weekly and longer" />
      <InfoCard label="Two weeks+" value="$50/day" detail="Our best rate" />
    </div>
    <p class="mt-6 text-base text-muted">
      One security deposit covers the whole period regardless of length, and if a quad
      develops a fault mid-rental we bring a replacement rather than leaving you without
      transport. Full rates on the <a href="/pricing" class="link-inline">pricing page</a>.
    </p>
  </section>

  <section class="page-x section-y" aria-labelledby="where-to-go">
    <SectionHeading
      eyebrow="Where to go"
      title="How far you can get"
      subtitle="Distances along the coast road from Playa Carmen, heading north."
    />
    <div class="mt-8">
      <RouteStrip />
    </div>
  </section>

  <CtaBand
    title="Reserve a quad"
    body="Tell us your dates, how many riders, and where you are staying. We will confirm availability and bring it to you."
    message="Hi! I'd like to book an ATV rental in Santa Teresa."
  />
</BaseLayout>
