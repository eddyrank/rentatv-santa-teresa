---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import RouteStrip from '../components/RouteStrip.astro';
import BookingWidget from '../components/BookingWidget.astro';
import InfoCard from '../components/InfoCard.astro';
import Photo from '../components/Photo.astro';
import { site, whatsappLink } from '../data/site';
import { serviceSchema } from '../data/schema';

const schema = serviceSchema({
  name: 'ATV rentals in Santa Teresa, Costa Rica',
  description:
    'Rent a fully automatic 4x4 ATV in Santa Teresa, Costa Rica. Mixed fleet of Can-Am, Honda and Kymco. Helmets and free hotel delivery included, full tank at pickup. From $50/day.',
  url: `${site.url}/atv-rentals`,
});

const fleet = [
  {
    photo: 'fleet-canam-side',
    alt: 'Red Can-Am Outlander 450 4x4 ATV available for rent in Santa Teresa',
    name: 'Can-Am Outlander 4x4',
    body: 'The Can-Am Outlander is one of the most capable machines we run. Fully automatic with selectable 4x4, it handles the unpaved tracks, the hill roads, and the muddy green-season sections without difficulty. A solid choice for riders who want to explore beyond the main road.',
    specs: ['Fully automatic', 'Selectable 4x4', '1–2 riders', 'Locking cargo box'],
  },
  {
    photo: 'fleet-honda-side',
    alt: 'Honda ATV with front and rear racks available for rent in Santa Teresa',
    name: 'Honda ATV',
    body: 'The Honda in our fleet is reliable, easy to ride, and well suited to the coast road between Santa Teresa and Mal País. Fully automatic, comfortable for one or two riders, and fitted with a cargo box on the back for bags, towels, and beach gear.',
    specs: ['Fully automatic', '1–2 riders', 'Front and rear racks', 'Locking cargo box'],
  },
  {
    photo: 'fleet-kymco-front',
    alt: 'Black Kymco 4x4 ATV available for rent in Santa Teresa',
    name: 'Kymco 4x4 ATV',
    body: 'The Kymco is straightforward and easy to get comfortable on fast — a good fit if this is your first time on a quad or you just want simple, predictable handling on the coast road. Fully automatic, with the same locking cargo box and passenger seat as the rest of the fleet.',
    specs: ['Fully automatic', '1–2 riders', 'Front and rear racks', 'Locking cargo box'],
  },
];

const fleetShared =
  "Whichever machine you get, it is fully automatic, fitted with front and rear cargo racks and a locking box on the back, and serviced between rentals rather than once a season. Santa Teresa's combination of dust, salt air, rain, and rough tracks is hard on vehicles, and regular maintenance is the only thing that keeps any of them reliable.";

const included = [
  'A helmet for every rider',
  'Full tank at pickup — return it full (fuel itself isn\'t included in the rate)',
  'Local route advice on where to ride',
  'Basic liability insurance',
  'Free delivery and collection in Santa Teresa',
  'Roadside help anywhere we rent',
  '4x4 storage box on every quad',
];

const bring = [
  "A valid driver's license from your home country — the physical card, not a photo",
  'Closed shoes (flip-flops are not safe on a quad)',
  'Sunglasses or eye protection',
  'A card or cash for the security deposit (from $500), refunded on return',
];

const areas = [
  'Playa Carmen', 'Santa Teresa', 'Playa Hermosa',
  'Mal País', 'Manzanillo', 'Montezuma',
  'Beaches and viewpoints around the Nicoya Peninsula',
];
---

<BaseLayout
  title="ATV Rentals Santa Teresa | Rent ATV Santa Teresa"
  description="Rent a fully automatic 4x4 ATV in Santa Teresa, Costa Rica — Can-Am, Honda or Kymco, helmets and free hotel delivery included, full tank at pickup. From $50/day."
  schema={schema}
>
  <Breadcrumb items={[{ label: 'ATV rentals', href: '/atv-rentals' }]} />

  <!-- Hero -->
  <section class="page-x section-y" aria-labelledby="rentals-hero">
    <div class="grid items-start gap-8 lg:grid-cols-[5fr_6fr] lg:gap-12">
      <div>
        <p class="eyebrow rule-marque">Self-drive · Santa Teresa</p>
        <h1 id="rentals-hero" class="mt-4 text-h2 sm:text-h1">
          ATV rentals in Santa Teresa, Costa Rica
        </h1>
        <p class="mt-5 max-w-lg text-lead text-muted">
          Rent an ATV in Santa Teresa and explore the beaches, jungle roads, and
          surrounding areas at your own pace. Our fully automatic 4x4
          quads are built for the dirt roads and rugged terrain around Santa
          Teresa and Mal País.
        </p>
        <p class="mt-4 max-w-lg text-base text-muted">
          Every ATV comes with 4x4, a locking cargo box and helmets, and
          starts you off with a full tank. We also offer free delivery and collection anywhere in
          Santa Teresa, making renting an ATV simple from your hotel, Airbnb, or
          other accommodation.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {[
            'Can-Am, Honda & Kymco fleet',
            'Fully automatic',
            '4x4 selectable',
            'Locking cargo box',
            'Free delivery',
            'Helmets included',
          ].map((s) => (
            <li class="rounded-sm bg-surface px-3 py-1.5 text-body text-muted">{s}</li>
          ))}
        </ul>
        <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-t border-hairline pt-5">
          <div>
            <dt class="text-body text-muted">From</dt>
            <dd class="stat-num">$50<span class="text-h4 font-normal text-muted">/day</span></dd>
          </div>
          <div>
            <dt class="text-body text-muted">Delivery</dt>
            <dd class="stat-num">Free</dd>
          </div>
          <div>
            <dt class="text-body text-muted">Riders</dt>
            <dd class="stat-num">1–2</dd>
          </div>
        </dl>
      </div>
      <div>
        <BookingWidget />
      </div>
    </div>
  </section>

  <!-- Why rent -->
  <section class="band-sand section-y" aria-labelledby="why-rent">
    <div class="page-x">
      <SectionHeading eyebrow="Why rent an ATV in Santa Teresa?" title="Freedom to explore the coast" />
      <div class="mt-6 grid gap-6 text-base text-muted lg:grid-cols-2 lg:gap-10">
        <div class="space-y-4">
          <p>Santa Teresa is spread along a long stretch of the Pacific coast, with beaches, restaurants, surf breaks, jungle roads, and accommodation spread across several kilometres. Renting an ATV makes getting around Santa Teresa much easier. You can ride to Playa Carmen for breakfast, head to Playa Hermosa for a surf, explore Mal País, or continue toward Manzanillo and Montezuma without relying on taxis or shuttles.</p>
          <p>The local dirt roads can become rough and muddy during the green season, which is why a properly maintained ATV with 4x4 is useful here.</p>
        </div>
        <div class="space-y-4">
          <p>For many visitors, renting an ATV is more than just transportation. It is a convenient way to see more of the Costa Rican landscape while enjoying the freedom to stop wherever you want.</p>
          <p>Whether you are visiting Santa Teresa for a few days, staying for a week, or looking for an easy way of getting around, an ATV gives you the freedom to explore beyond the main road.</p>
        </div>
      </div>
      <div class="mt-10">
        <Photo
          name="jungle-trail"
          alt="Jungle path opening onto a beach near Santa Teresa, Costa Rica"
          sizes="100vw"
          ratio="16/9"
          class="rounded-media"
        />
      </div>
    </div>
  </section>

  <!-- Fleet -->
  <section class="page-x section-y" aria-labelledby="fleet">
    <SectionHeading eyebrow="The fleet" title="Three machines, properly kept" subtitle="We run three models rather than whatever was cheapest — each picked for what it does well, and every one of them serviced between rentals, not once a season." />
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {fleet.map((quad) => (
        <article class="flex flex-col">
          <div class="photo-card">
            {quad.photo ? (
              <Photo name={quad.photo} alt={quad.alt} />
            ) : (
              <div class="flex aspect-[4/3] items-center justify-center bg-jungle-800">
                <img
                  src="/canam-float-700.webp"
                  alt={quad.alt}
                  width="200"
                  height="131"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-36 opacity-80 [filter:drop-shadow(0_8px_12px_rgba(0,0,0,0.4))]"
                />
              </div>
            )}
          </div>
          <h3 class="mt-4 text-h4">{quad.name}</h3>
          <p class="mt-2 flex-1 text-base text-muted">{quad.body}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {quad.specs.map((spec) => (
              <li class="rounded-sm bg-surface px-3 py-1.5 text-body text-muted">{spec}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="mt-8 max-w-3xl text-base text-muted">{fleetShared}</p>
  </section>

  <!-- Included / bring -->
  <section class="band-sand section-y" aria-labelledby="whats-included">
    <div class="page-x">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <SectionHeading eyebrow="What you get" title="Included with every rental" />
          <p class="mt-3 text-base text-muted">There are no complicated pickup arrangements. Tell us where you are staying and we can bring the ATV directly to your hotel, Airbnb, or accommodation in Santa Teresa.</p>
          <ul class="mt-5 space-y-3">
            {included.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <SectionHeading eyebrow="What to bring" title="Turn up with these" />
          <p class="mt-3 text-base text-muted">If you are visiting Santa Teresa to surf, a small bag with your sunglasses, towel, water, and other essentials can easily fit in the cargo box.</p>
          <ul class="mt-5 space-y-3">
            {bring.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-ink-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" stroke-linecap="round" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Rates -->
  <section class="page-x section-y" aria-labelledby="multi-day">
    <SectionHeading eyebrow="Staying a while?" title="Rates drop from three days" subtitle="Santa Teresa runs several kilometres along the coast, and many visitors stay for a week or longer. If you are here for several days, renting day by day can quickly become expensive. Longer rentals give you a better daily rate and make it easier to explore Santa Teresa and the surrounding areas without arranging transportation every day." />
    <div class="mt-8 grid gap-6 sm:grid-cols-4">
      <InfoCard label="Under 3 days" value="$65/day" detail="Full-day rentals" />
      <InfoCard label="3 to 7 days" value="$60/day" detail="The most popular range" />
      <InfoCard label="Over 7 days" value="$55/day" detail="Weekly and longer" />
      <InfoCard label="Two weeks+" value="$50/day" detail="Our best rate" />
    </div>
    <p class="mt-6 text-base text-muted">One security deposit covers the whole rental period regardless of length. If your quad develops a fault during your rental, we will bring a replacement rather than leave you without transportation. Full rates on the <a href="/pricing" class="link-inline">pricing page</a>.</p>
  </section>

  <!-- Where to go -->
  <section class="page-x section-y" aria-labelledby="where-to-go">
    <SectionHeading eyebrow="Where to go" title="How far you can get" subtitle="Distances along the coast road from Santa Teresa, heading north. Approximate riding times can vary depending on road conditions, traffic, weather, and your route." />
    <div class="mt-8">
      <RouteStrip />
    </div>
    <div class="mt-8">
      <Photo
        name="cove-sunset"
        alt="Quiet beach cove along the Santa Teresa coast at sunset"
        sizes="100vw"
        ratio="16/9"
        class="rounded-media"
      />
    </div>
  </section>

  <!-- Explore beyond -->
  <section class="band-sand section-y" aria-labelledby="explore">
    <div class="page-x grid gap-8 lg:grid-cols-2 lg:gap-12 lg:items-start">
      <div>
        <SectionHeading eyebrow="Explore Santa Teresa, Mal País, and beyond" title="Get more out of your time here" />
        <p class="mt-5 text-base text-muted">One of the biggest advantages of renting an ATV is being able to explore beyond the immediate town. Depending on road conditions and your plans, you can use your rental to visit:</p>
        <ul class="mt-4 space-y-2">
          {areas.map((a) => (
            <li class="flex items-center gap-2 text-base text-ink-2">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-marque" aria-hidden="true"></span>
              {a}
            </li>
          ))}
        </ul>
        <p class="mt-5 text-base text-muted">Always check current road conditions before heading farther from Santa Teresa, especially during the rainy season.</p>
      </div>
      <div class="space-y-6">
        <div class="card">
          <h3 class="text-h4">ATV rental for surfers</h3>
          <p class="mt-3 text-base text-muted">Santa Teresa is a surf destination, and having your own transportation can make it easier to move between different beaches and surf spots. An ATV gives you the flexibility to check the waves in Santa Teresa, ride toward Playa Hermosa, or explore the coast around Mal País when conditions change. The locking cargo box also gives you useful storage for smaller personal items while you are getting around.</p>
        </div>
        <div class="card">
          <h3 class="text-h4">ATV rental vs. getting around by taxi</h3>
          <p class="mt-3 text-base text-muted">Taxis and shuttles are useful for individual trips, but the costs can add up when you are moving around Santa Teresa several times a day. With your own ATV, you can go to the beach whenever you want, visit different parts of Santa Teresa, explore Mal País, pick up groceries, get to restaurants and surf spots, avoid waiting for a taxi, and carry your bags and beach gear.</p>
          <p class="mt-3 text-base text-muted">For visitors staying several days, an ATV rental can be a practical way of getting around Santa Teresa while also turning transportation into part of the adventure. For a longer look at the options, read our guide on <a href="/blog/getting-around-santa-teresa" class="link-inline">getting around Santa Teresa</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick FAQ -->
  <section class="page-x section-y" aria-labelledby="faq-rentals">
    <SectionHeading eyebrow="Quick answers" title="Frequently asked questions" />
    <dl class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {[
        { q: "Do I need a driver's license?", a: "Yes. You need a valid physical driver's license from your home country. A photo or digital copy is not accepted." },
        { q: 'Can two people ride one ATV?', a: 'Yes. Every quad in our fleet can accommodate one or two riders.' },
        { q: 'Do you deliver in Santa Teresa?', a: 'Yes. Free delivery and collection within Santa Teresa.' },
        { q: 'Can I ride to Montezuma?', a: 'Yes. It is approximately 22 km and takes around 50 minutes depending on conditions.' },
        { q: 'Is 4x4 useful here?', a: 'Yes. Many roads are unpaved and can become rough or muddy.' },
        { q: 'Is fuel included?', a: 'The tank is full when you pick up and is expected to come back full. Fuel itself is not included in the rental price, but you always start with a full tank.' },
        { q: 'Are helmets included?', a: 'Yes. One helmet per rider, included with every rental.' },
        { q: 'Can I rent for a week?', a: 'Yes. Longer rentals have discounted daily rates starting from 3 days.' },
      ].map(({ q, a }) => (
        <div class="rounded-md border border-hairline p-5">
          <dt class="font-semibold text-ink-2">{q}</dt>
          <dd class="mt-2 text-base text-muted">{a}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-6 text-base text-muted">More questions? Read the full <a href="/faq" class="link-inline">FAQ page</a>.</p>
  </section>

  <!-- CTA -->
  <CtaBand
    title="Reserve a quad"
    body="Tell us your dates, how many riders, and where you are staying. We will check availability and bring the ATV to you."
    message="Hi! I'd like to book an ATV rental in Santa Teresa."
  />
</BaseLayout>
