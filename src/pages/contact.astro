---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { site, whatsappLink } from '../data/site';
---

<BaseLayout
  title="Contact — ATV rentals in Santa Teresa | Rent ATV Santa Teresa"
  description="Contact Rent ATV Santa Teresa to book a quad. WhatsApp is fastest — we reply within minutes during opening hours. Free delivery to hotels in Santa Teresa and Mal País."
>
  <Breadcrumb items={[{ label: 'Contact', href: '/contact' }]} />
  <PageHero
    eyebrow="Get in touch"
    title="Contact us"
    subtitle="WhatsApp is by far the quickest way to reach us and the way most bookings happen. The form below works too if you would rather write it all out."
  />

  <section class="page-x section-y" aria-labelledby="contact-methods">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
      <!-- Contact details -->
      <div>
        <SectionHeading eyebrow="Fastest route" title="Message us" />

        <a href={whatsappLink()} class="btn-primary mt-6 w-full sm:w-auto" rel="noopener" target="_blank">
          <WhatsAppIcon class="h-4 w-4" />
          Open WhatsApp
        </a>

        <!-- NAP block — identical to the footer and the JSON-LD schema -->
        <address class="mt-10 space-y-1 text-base not-italic text-muted">
          <span class="block font-semibold text-ink-2">{site.name}</span>
          <span class="block">{site.address.street}</span>
          <span class="block">{site.address.locality}, {site.address.region}, {site.address.countryName}</span>
        </address>

        <dl class="mt-8 space-y-5 text-base">
          <div>
            <dt class="text-body text-muted">Phone</dt>
            <dd class="mt-1"><a href={`tel:${site.phoneHref}`} class="link-list">{site.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt class="text-body text-muted">Email</dt>
            <dd class="mt-1"><a href={`mailto:${site.email}`} class="link-list">{site.email}</a></dd>
          </div>
          <div>
            <dt class="text-body text-muted">Opening hours</dt>
            <dd class="mt-1 space-y-1">
              {site.hours.map((block) => (
                <span class="block">{block.label} · {block.time}</span>
              ))}
            </dd>
          </div>
        </dl>

        <!-- PLACEHOLDER — embed Google Map here, inside the 20px media mask -->
        <div class="media-frame mt-10 flex min-h-[280px] items-center justify-center">
          <p class="text-body text-muted">Map placeholder</p>
        </div>
      </div>

      <!-- Contact form -->
      <div>
        <SectionHeading eyebrow="Or write to us" title="Send a message" />

        <p class="mt-3 text-base text-muted">
          Include your dates, the number of riders and where you are staying, and we
          can usually confirm availability in one reply.
        </p>

        <!-- FORM BACKEND NOT CONFIGURED.
             Point action= at Formspree, Netlify Forms or similar before launch. -->
        <form action="#" method="POST" class="mt-8 space-y-5">
          <div>
            <label for="name" class="field-label">Name (required)</label>
            <input type="text" id="name" name="name" required autocomplete="name" class="field-input" />
          </div>

          <div>
            <label for="email" class="field-label">Email (required)</label>
            <input type="email" id="email" name="email" required autocomplete="email" class="field-input" />
          </div>

          <div>
            <label for="dates" class="field-label">Rental dates</label>
            <input type="text" id="dates" name="dates" placeholder="e.g. 14 to 18 March" class="field-input" />
          </div>

          <div>
            <label for="subject" class="field-label">Subject</label>
            <select id="subject" name="subject" class="field-input">
              <option>Self-drive rental</option>
              <option>Rental of a week or more</option>
              <option>Something else</option>
            </select>
          </div>

          <div>
            <label for="message" class="field-label">Message (required)</label>
            <textarea id="message" name="message" rows="5" required class="field-input"></textarea>
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto">Send message</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
