---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import BookingWidget from '../components/BookingWidget.astro';
import Card from '../components/Card.astro';
import { site, whatsappLink } from '../data/site';
---

<BaseLayout
  title="Contact — ATV Rentals Santa Teresa | Rent ATV Santa Teresa"
  description="Message us on WhatsApp to book a quad in Santa Teresa, Costa Rica. We reply in minutes during opening hours. Free delivery in Santa Teresa, Mal País, Playa Carmen and Playa Hermosa, with an extra fee to Cóbano or Cabuya."
>
  <Breadcrumb items={[{ label: 'Contact', href: '/contact' }]} />
  <PageHero
    eyebrow="Get in touch"
    title="Contact us"
    subtitle="WhatsApp is the fastest way to reach us. Send your dates and number of riders — we deliver directly to your hotel, you never need to come to us."
  />

  <section class="page-x section-y" aria-labelledby="contact-methods">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">

      <!-- Booking widget -->
      <div class="lg:col-span-1">
        <BookingWidget />
      </div>

      <!-- No widget = just WA button fallback -->
      <div class="hidden lg:block">
        <SectionHeading eyebrow="Or reach us directly" title="Just want to chat?" />
        <p class="mt-4 text-base text-muted">
          No dates yet? Message us directly on WhatsApp and we will help you
          figure out what works for your trip.
        </p>
        <a
          href={whatsappLink("Hi! I'd like to rent an ATV in Santa Teresa.")}
          class="btn-primary mt-8 w-full sm:w-auto"
          rel="noopener"
          target="_blank"
        >
          <WhatsAppIcon class="h-4 w-4" />
          Open WhatsApp
        </a>

        <!-- NAP — identical to footer and JSON-LD. No street line: this is a
             delivery-only business with no storefront to list an address for. -->
        <address class="mt-10 space-y-1 text-base not-italic text-muted">
          <span class="block font-semibold text-ink-2">{site.name}</span>
          <span class="block">
            {site.address.locality}, {site.address.region}, {site.address.countryName}
          </span>
        </address>

        <dl class="mt-6 space-y-4 text-base">
          <div>
            <dt class="text-body text-muted">WhatsApp / Phone</dt>
            <dd class="mt-1">
              <a href={`tel:${site.phoneHref}`} class="link-list font-semibold">{site.phoneDisplay}</a>
            </dd>
          </div>
          <div>
            <dt class="text-body text-muted">Hours</dt>
            <dd class="mt-1 font-semibold text-ink-2">Every day · 6:00am – 11:00pm</dd>
          </div>
        </dl>
      </div>

      <!-- Map -->
      <div class="flex flex-col gap-6">
        <div id="contact-map" class="media-frame overflow-hidden lg:flex-1" style="min-height:300px; background:#0E2B24;">
        </div>
        <script is:inline>
          (function() {
            var el = document.getElementById('contact-map');
            if (!el) return;
            var fr = document.createElement('iframe');
            fr.src = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d31476.47!2d-85.18!3d9.645!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f9fbb2e18f5bcb5%3A0x88c67a25b2e87ea2!2sSanta%20Teresa%2C%20Puntarenas%2C%20Costa%20Rica!5e0!3m2!1sen!2s!4v1724000000000!5m2!1sen!2s';
            fr.width = '100%'; fr.height = '300';
            fr.style.cssText = 'border:0;border-radius:20px;display:block;';
            fr.setAttribute('allowfullscreen', '');
            fr.setAttribute('loading', 'lazy');
            fr.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
            fr.setAttribute('title', 'Santa Teresa, Costa Rica — ATV rental delivery area');
            el.appendChild(fr);
          })();
        </script>

        <div class="grid grid-cols-2 gap-4">
          <div class="card">
            <p class="text-body text-muted">Delivery</p>
            <p class="mt-1 text-h4 font-semibold">Free</p>
            <p class="mt-1 text-body text-muted">Santa Teresa to Playa Hermosa</p>
          </div>
          <div class="card">
            <p class="text-body text-muted">Response</p>
            <p class="mt-1 text-h4 font-semibold">Minutes</p>
            <p class="mt-1 text-body text-muted">During opening hours</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works: adds real, non-duplicate content for a page that was
       previously just a form + address block -->
  <section class="band-sand section-y" aria-labelledby="how-it-works">
    <div class="page-x">
      <SectionHeading
        eyebrow="How it works"
        title="Booking takes three steps"
        subtitle="There is no counter to visit and no reservation form to fill in beyond the dates. Everything runs through WhatsApp, start to finish."
      />
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        <Card
          icon="route"
          title="1. Send your dates"
          body="Message us your dates, number of riders and where you are staying. We check which quads are free and confirm the daily rate for the length of your stay."
        />
        <Card
          icon="pin"
          title="2. We deliver to you"
          body="No pickup counter to find. The ATV comes to your hotel, Airbnb or villa, with a full tank and a helmet for every rider already on board."
        />
        <Card
          icon="clock"
          title="3. Ride from your door"
          body="We walk you through the controls on the spot, you sign, and you are riding within minutes. Collection at the end works the same way, in reverse."
        />
      </div>
    </div>
  </section>

  <!-- Delivery area -->
  <section class="page-x section-y" aria-labelledby="delivery-area">
    <SectionHeading
      eyebrow="Where we deliver"
      title="Free delivery across the Santa Teresa area"
      subtitle="Delivery and collection are free anywhere between Santa Teresa and Playa Hermosa. Further out, we still come to you for a small extra fee."
    />
    <p class="mt-6 max-w-3xl text-base text-muted">
      We deliver at no charge to {site.areaServed.slice(0, -1).join(', ')} and
      {site.areaServed[site.areaServed.length - 1]}. If you are staying somewhere
      not listed here, message us your location anyway — we can usually still
      make it work, just ask before you book.
    </p>
    <p class="mt-4 max-w-3xl text-base text-muted">
      Before you message us, it helps to have your rental dates, the number of
      riders, and your accommodation's name on hand. If you are not sure what
      is included or what you need to bring, the
      <a href="/atv-rentals" class="link-inline">ATV rentals page</a> and the
      <a href="/faq" class="link-inline">FAQ</a> cover licence requirements,
      insurance and what to wear. For a broader look at getting around once you
      arrive, see our guide to
      <a href="/blog/getting-around-santa-teresa" class="link-inline">getting around Santa Teresa</a>.
    </p>
  </section>
</BaseLayout>
