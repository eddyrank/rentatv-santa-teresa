---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import BookingWidget from '../components/BookingWidget.astro';
import { site, whatsappLink } from '../data/site';
---

<BaseLayout
  title="Contact — ATV rentals in Santa Teresa | Rent ATV Santa Teresa"
  description="Message us on WhatsApp to book a quad in Santa Teresa, Costa Rica. We reply in minutes during opening hours. Free delivery to hotels in Santa Teresa and Mal País."
>
  <Breadcrumb items={[{ label: 'Contact', href: '/contact' }]} />
  <PageHero
    eyebrow="Get in touch"
    title="Contact us"
    subtitle="WhatsApp is the fastest way to reach us. Send your dates and number of riders and we reply in minutes during opening hours."
  />

  <section class="page-x section-y" aria-labelledby="contact-methods">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">

      <!-- Booking widget -->
      <div class="lg:col-span-1">
        <BookingWidget />
      </div>

      <!-- No widget = just WA button fallback -->
      <div class="hidden lg:block">
        <SectionHeading eyebrow="Or reach us directly" title="Just want to chat?" />
        <p class="mt-4 text-base text-muted">
          No dates yet? Message us directly on WhatsApp and we will help you
          figure out what works for your trip.
        </p>
        <a
          href={whatsappLink("Hi! I'd like to rent an ATV in Santa Teresa.")}
          class="btn-primary mt-8 w-full sm:w-auto"
          rel="noopener"
          target="_blank"
        >
          <WhatsAppIcon class="h-4 w-4" />
          Open WhatsApp
        </a>

        <!-- NAP — identical to footer and JSON-LD -->
        <address class="mt-10 space-y-1 text-base not-italic text-muted">
          <span class="block font-semibold text-ink-2">{site.name}</span>
          <span class="block">{site.address.street}</span>
          <span class="block">
            {site.address.locality}, {site.address.region}, {site.address.countryName}
          </span>
        </address>

        <dl class="mt-6 space-y-4 text-base">
          <div>
            <dt class="text-body text-muted">WhatsApp / Phone</dt>
            <dd class="mt-1">
              <a href={`tel:${site.phoneHref}`} class="link-list font-semibold">{site.phoneDisplay}</a>
            </dd>
          </div>
          <div>
            <dt class="text-body text-muted">Opening hours</dt>
            <dd class="mt-1 space-y-0.5">
              {site.hours.map((block) => (
                <span class="block">{block.label} · {block.time}</span>
              ))}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Map placeholder + quick facts -->
      <div class="flex flex-col gap-6">
        <div class="media-frame overflow-hidden lg:flex-1" style="min-height:300px">
          <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d31476.47!2d-85.18!3d9.645!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f9fbb2e18f5bcb5%3A0x88c67a25b2e87ea2!2sSanta%20Teresa%2C%20Puntarenas%2C%20Costa%20Rica!5e0!3m2!1sen!2s!4v1724000000000!5m2!1sen!2s"
              width="100%"
              height="300"
              style="border:0; border-radius:20px; display:block;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Santa Teresa, Costa Rica — ATV rental delivery area"
            ></iframe>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="card">
            <p class="text-body text-muted">Delivery</p>
            <p class="mt-1 text-h4 font-semibold">Free</p>
            <p class="mt-1 text-body text-muted">Santa Teresa &amp; Mal País</p>
          </div>
          <div class="card">
            <p class="text-body text-muted">Response</p>
            <p class="mt-1 text-h4 font-semibold">Minutes</p>
            <p class="mt-1 text-body text-muted">During opening hours</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
