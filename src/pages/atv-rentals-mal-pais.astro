---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import RouteStrip from '../components/RouteStrip.astro';
import BookingWidget from '../components/BookingWidget.astro';
import InfoCard from '../components/InfoCard.astro';
import Photo from '../components/Photo.astro';
import { site, whatsappLink } from '../data/site';
import { serviceSchema, faqSchema } from '../data/schema';

const faqs = [
  {
    q: 'Why rent an ATV in Mal País specifically?',
    a: "Mal País is quieter and more spread out than Santa Teresa, with far fewer shops, restaurants and ATMs clustered together. What would be a long, hot walk to get groceries or find a café becomes a five-minute ride.",
  },
  {
    q: 'Can my ATV be delivered to a villa or Airbnb in Mal País?',
    a: 'Yes, free delivery and collection is available at hotels, villas and Airbnbs in Mal País. Tell us where you are staying and we bring the quad to you with a full tank and a helmet for every rider.',
  },
  {
    q: "Is it far to walk to a store or restaurant from Mal País?",
    a: "It depends where you are staying, but many accommodations in Mal País sit well outside the small cluster of shops and sodas, and there is no continuous sidewalk. A 20–30 minute walk each way in the heat is common — an ATV turns that into a couple of minutes.",
  },
  {
    q: 'Can I ride from Mal País into Santa Teresa town?',
    a: "Yes. Santa Teresa's busier strip, with most of the restaurants, supermarkets and bank machines, is a short ride up the coast road from Mal País.",
  },
  {
    q: "Do I need a driver's license?",
    a: "Yes. You need a valid physical driver's license from your home country. A photo or digital copy is not accepted.",
  },
  {
    q: 'Can two people ride one ATV?',
    a: 'Yes. Every quad in our fleet can accommodate one or two riders.',
  },
  {
    q: 'Can I ride toward Montezuma from Mal País?',
    a: 'Yes, conditions permitting. It is a longer ride than from Santa Teresa, so ask us about current road conditions before heading that way.',
  },
  {
    q: 'Is fuel included?',
    a: 'The tank is full when you pick up and is expected to come back full. Fuel itself is not included in the rental price, but you always start with a full tank.',
  },
];

const schema = [
  serviceSchema({
    name: 'ATV rentals in Mal País, Costa Rica',
    description:
      'Rent a fully automatic 4x4 ATV in Mal País, Costa Rica, with free delivery to your hotel or Airbnb. Helmets included, full tank at pickup. From $50/day.',
    url: `${site.url}/atv-rentals-mal-pais`,
    offers: [
      { price: 65, description: 'Daily rate for rentals under 3 days' },
      { price: 60, description: 'Daily rate for rentals of 3 to 7 days' },
      { price: 55, description: 'Daily rate for rentals over 7 days' },
      { price: 50, description: 'Daily rate for rentals of two weeks or more' },
    ],
  }),
  faqSchema(faqs),
];

const fleet = [
  {
    photo: 'fleet-canam-side',
    alt: 'Red Can-Am Outlander 450 4x4 ATV available for rent in Mal País',
    name: 'Can-Am Outlander 4x4',
    body: "The Can-Am is the machine we point toward the longer rides — north into Santa Teresa for groceries and restaurants, or further out toward Manzanillo. Fully automatic with selectable 4x4, it copes well with the looser, less-maintained tracks around Mal País.",
    specs: ['Fully automatic', 'Selectable 4x4', '1–2 riders', 'Locking cargo box'],
  },
  {
    photo: 'fleet-honda-side',
    alt: 'Honda ATV with front and rear racks available for rent in Mal País',
    name: 'Honda ATV',
    body: 'Reliable and easy to ride, the Honda suits the short hops most Mal País visitors actually make — down to the beach, along to Playa Carmen, or up the coast road into Santa Teresa. The cargo box on the back is enough for a beach bag and groceries.',
    specs: ['Fully automatic', '1–2 riders', 'Front and rear racks', 'Locking cargo box'],
  },
  {
    photo: 'fleet-kymco-front',
    alt: 'Black Kymco 4x4 ATV available for rent in Mal País',
    name: 'Kymco 4x4 ATV',
    body: 'Straightforward and easy to get comfortable on fast — a good fit if this is your first time on a quad. Given how spread out Mal País is, most guests find they are riding confidently within the first few minutes, well before the first grocery run.',
    specs: ['Fully automatic', '1–2 riders', 'Front and rear racks', 'Locking cargo box'],
  },
];

const fleetShared =
  "Whichever machine you get, it is fully automatic, fitted with front and rear cargo racks and a locking box on the back, and serviced between rentals rather than once a season. The unpaved roads around Mal País are hard on vehicles, and regular maintenance is the only thing that keeps any of them reliable.";

const included = [
  'A helmet for every rider',
  "Full tank at pickup — return it full (fuel itself isn't included in the rate)",
  'Local route advice on where to ride',
  'Basic liability insurance',
  'Free delivery and collection in Mal País',
  'Roadside help anywhere we rent',
  '4x4 storage box on every quad',
];

const bring = [
  "A valid driver's license from your home country — the physical card, not a photo",
  'Closed shoes (flip-flops are not safe on a quad)',
  'Sunglasses or eye protection',
  'A card or cash for the security deposit (from $500), refunded on return',
];

const areas = [
  'Santa Teresa town centre', 'Playa Carmen', 'Playa Hermosa',
  'Manzanillo', 'Montezuma',
  'Beaches and viewpoints around the Nicoya Peninsula',
];

const routeStops = [
  { place: 'Mal País', km: '0 km', note: 'Start' },
  { place: 'Santa Teresa', km: '3 km', note: '8 min' },
  { place: 'Playa Carmen', km: '5 km', note: '12 min' },
  { place: 'Playa Hermosa', km: '8 km', note: '18 min' },
  { place: 'Montezuma', km: '25 km', note: '55 min' },
];
---

<BaseLayout
  title="ATV Rental Mal País | Rent ATV Santa Teresa"
  description="Rent a 4x4 ATV in Mal País, Costa Rica. Free delivery to your hotel skips the long walk to shops and cafés up the coast. From $50/day."
  schema={schema}
>
  <Breadcrumb items={[{ label: 'ATV rentals', href: '/atv-rentals' }, { label: 'Mal País', href: '/atv-rentals-mal-pais' }]} />

  <!-- Hero -->
  <section class="page-x section-y" aria-labelledby="rentals-hero">
    <div class="grid items-start gap-8 lg:grid-cols-[5fr_6fr] lg:gap-12">
      <div>
        <p class="eyebrow rule-marque">Self-drive · Mal País</p>
        <h1 id="rentals-hero" class="mt-4 text-h2 sm:text-h1">
          ATV rentals in Mal País, Costa Rica
        </h1>
        <p class="mt-5 max-w-lg text-lead text-muted">
          Mal País is the quiet end of this stretch of coast — more spread
          out than Santa Teresa, with far fewer shops, cafés and restaurants
          within easy walking distance. Renting an ATV is how most visitors
          here get around that.
        </p>
        <p class="mt-4 max-w-lg text-base text-muted">
          Every ATV comes with 4x4, a locking cargo box and helmets, and
          starts you off with a full tank. We deliver free to hotels, villas
          and Airbnbs anywhere in Mal País, so you are riding within minutes
          of arriving rather than arranging your own way to a rental counter.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {[
            'Can-Am, Honda & Kymco fleet',
            'Fully automatic',
            '4x4 selectable',
            'Locking cargo box',
            'Free delivery to Mal País',
            'Helmets included',
          ].map((s) => (
            <li class="rounded-sm bg-surface px-3 py-1.5 text-body text-muted">{s}</li>
          ))}
        </ul>
        <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-t border-hairline pt-5">
          <div>
            <dt class="text-body text-muted">From</dt>
            <dd class="stat-num">$50<span class="text-h4 font-normal text-muted">/day</span></dd>
          </div>
          <div>
            <dt class="text-body text-muted">Delivery</dt>
            <dd class="stat-num">Free</dd>
          </div>
          <div>
            <dt class="text-body text-muted">Riders</dt>
            <dd class="stat-num">1–2</dd>
          </div>
        </dl>
      </div>
      <div>
        <BookingWidget />
      </div>
    </div>
  </section>

  <!-- Why remoteness matters -->
  <section class="band-sand section-y" aria-labelledby="why-remote">
    <div class="page-x">
      <SectionHeading eyebrow="Why an ATV here" title="Mal País is remote for a reason — and that's the appeal" />
      <div class="mt-6 grid gap-6 text-base text-muted lg:grid-cols-2 lg:gap-10">
        <div class="space-y-4">
          <p>Mal País sits at the quieter, southern end of the coast road, past the point where Santa Teresa's shops, restaurants and surf schools thin out. It's part of what people come here for — fewer crowds, more space, a slower pace. The trade-off is that day-to-day errands take longer than they would somewhere more built up.</p>
          <p>Most of the grocery stores, cafés, pharmacies, and cash machines that visitors rely on are clustered up the road in Santa Teresa's town centre, not in Mal País itself. Depending on where you are staying, that can mean a 20 to 30 minute walk each way, on roads with no continuous sidewalk and little shade.</p>
        </div>
        <div class="space-y-4">
          <p>An ATV closes that gap. The same trip that's a long, hot walk on foot is a five-to-ten minute ride on a quad — and you come back with your groceries and beach gear in the locking cargo box instead of carrying them the whole way.</p>
          <p>It also means you're not stuck choosing between staying somewhere quiet in Mal País and being able to get to a restaurant or supermarket easily. With your own ATV, you get both: the remoteness when you want it, and quick access to Santa Teresa's services when you need them.</p>
        </div>
      </div>
      <div class="mt-10">
        <Photo
          name="malpais-cove"
          alt="Quiet, undeveloped cove on the Mal País coastline south of Santa Teresa"
          sizes="100vw"
          ratio="16/9"
          class="rounded-media"
        />
      </div>
    </div>
  </section>

  <!-- Fleet -->
  <section class="page-x section-y" aria-labelledby="fleet">
    <SectionHeading eyebrow="The fleet" title="Three machines, properly kept" subtitle="We run three models rather than whatever was cheapest — each picked for what it does well, and every one of them serviced between rentals, not once a season." />
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {fleet.map((quad) => (
        <article class="flex flex-col">
          <div class="photo-card">
            <Photo name={quad.photo} alt={quad.alt} />
          </div>
          <h3 class="mt-4 text-h4">{quad.name}</h3>
          <p class="mt-2 flex-1 text-base text-muted">{quad.body}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {quad.specs.map((spec) => (
              <li class="rounded-sm bg-surface px-3 py-1.5 text-body text-muted">{spec}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="mt-8 max-w-3xl text-base text-muted">{fleetShared}</p>
  </section>

  <!-- Included / bring -->
  <section class="band-sand section-y" aria-labelledby="whats-included">
    <div class="page-x">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <SectionHeading eyebrow="What you get" title="Included with every rental" />
          <p class="mt-3 text-base text-muted">There are no complicated pickup arrangements, which matters more here than in town — tell us where you are staying in Mal País and we bring the ATV directly to your hotel, villa or Airbnb.</p>
          <ul class="mt-5 space-y-3">
            {included.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <SectionHeading eyebrow="What to bring" title="Turn up with these" />
          <p class="mt-3 text-base text-muted">If your first stop is a grocery run in Santa Teresa, a bag with your wallet, sunglasses and water fits easily in the cargo box.</p>
          <ul class="mt-5 space-y-3">
            {bring.map((item) => (
              <li class="flex items-start gap-3 text-base text-ink-2">
                <svg class="mt-1 h-4 w-4 shrink-0 text-ink-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" stroke-linecap="round" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Rates -->
  <section class="page-x section-y" aria-labelledby="multi-day">
    <SectionHeading eyebrow="Staying a while?" title="Rates drop from three days" subtitle="Many visitors choose Mal País specifically to stay put for a week or longer. If you're here for several days, renting day by day adds up fast, and a longer rental means you always have a way to reach Santa Teresa without arranging transportation every time." />
    <div class="mt-8 grid gap-6 sm:grid-cols-4">
      <InfoCard label="Under 3 days" value="$65/day" detail="Full-day rentals" />
      <InfoCard label="3 to 7 days" value="$60/day" detail="The most popular range" />
      <InfoCard label="Over 7 days" value="$55/day" detail="Weekly and longer" />
      <InfoCard label="Two weeks+" value="$50/day" detail="Our best rate" />
    </div>
    <p class="mt-6 text-base text-muted">One security deposit covers the whole rental period regardless of length. If your quad develops a fault during your rental, we will bring a replacement rather than leave you without transportation. Full rates on the <a href="/pricing" class="link-inline">pricing page</a>.</p>
  </section>

  <!-- Where to go -->
  <section class="page-x section-y" aria-labelledby="where-to-go">
    <SectionHeading eyebrow="Where to go" title="How far Mal País actually is from things" subtitle="Distances along the coast road from Mal País, heading north toward Santa Teresa. Approximate riding times can vary depending on road conditions, traffic, weather, and your route." />
    <div class="mt-8">
      <RouteStrip stops={routeStops} />
    </div>
    <div class="mt-8">
      <Photo
        name="cove-sunset"
        alt="Quiet beach cove along the coast near Mal País at sunset"
        sizes="100vw"
        ratio="16/9"
        class="rounded-media"
      />
    </div>
  </section>

  <!-- Explore beyond -->
  <section class="band-sand section-y" aria-labelledby="explore">
    <div class="page-x grid gap-8 lg:grid-cols-2 lg:gap-12 lg:items-start">
      <div>
        <SectionHeading eyebrow="Explore Mal País, Santa Teresa, and beyond" title="Get more out of your time here" />
        <p class="mt-5 text-base text-muted">Once you have an ATV, Mal País stops feeling remote. Depending on road conditions and your plans, you can use your rental to visit:</p>
        <ul class="mt-4 space-y-2">
          {areas.map((a) => (
            <li class="flex items-center gap-2 text-base text-ink-2">
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-marque" aria-hidden="true"></span>
              {a}
            </li>
          ))}
        </ul>
        <p class="mt-5 text-base text-muted">Always check current road conditions before heading farther from Mal País, especially during the rainy season.</p>
      </div>
      <div class="space-y-6">
        <div class="card">
          <h3 class="text-h4">Groceries, cafés and cash — solved</h3>
          <p class="mt-3 text-base text-muted">The most common question we get from guests staying in Mal País is simply: how do I get to a supermarket or an ATM? On foot, it's a genuine trek in the heat, with no reliable sidewalk for most of the way. On an ATV, it's a short, easy ride up the coast road into Santa Teresa, where the bulk of the shops, restaurants and cash machines are concentrated.</p>
        </div>
        <div class="card">
          <h3 class="text-h4">ATV rental vs. walking or taxis</h3>
          <p class="mt-3 text-base text-muted">Taxis exist, but waiting on one for a quick grocery run gets old fast, and walking isn't realistic for most of what you'll need during a longer stay. With your own ATV, you go when you want — to the beach, into town, to a restaurant for dinner — and carry what you buy back in the cargo box instead of on your back.</p>
          <p class="mt-3 text-base text-muted">For visitors staying several days in Mal País, an ATV isn't just convenient, it's usually the difference between feeling isolated and actually enjoying the quiet. For a longer look at the options, read our guide on <a href="/blog/getting-around-santa-teresa" class="link-inline">getting around Santa Teresa</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick FAQ -->
  <section class="page-x section-y" aria-labelledby="faq-rentals">
    <SectionHeading eyebrow="Quick answers" title="Frequently asked questions" />
    <dl class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {faqs.map(({ q, a }) => (
        <div class="rounded-md border border-hairline p-5">
          <dt class="font-semibold text-ink-2">{q}</dt>
          <dd class="mt-2 text-base text-muted">{a}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-6 text-base text-muted">More questions? Read the full <a href="/faq" class="link-inline">FAQ page</a>.</p>
  </section>

  <!-- CTA -->
  <CtaBand
    title="Reserve a quad in Mal País"
    body="Tell us your dates, how many riders, and where you are staying. We will check availability and bring the ATV to you."
    message="Hi! I'd like to book an ATV rental in Mal País."
  />
</BaseLayout>
