---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqSchema } from '../data/schema';

/**
 * These questions are written to match how visitors actually search — full
 * natural-language questions rather than keyword fragments. That is what gets
 * pulled into AI answers and Google's "People also ask".
 * PLACEHOLDER: verify every legal and operational detail with the owner.
 */
const booking = [
  {
    q: 'Do I need a licence to rent an ATV in Santa Teresa?',
    a: 'Yes. Costa Rican law requires a valid driver’s licence from your home country to operate an ATV on public roads. A standard car licence is enough — you do not need a motorcycle endorsement. Bring the physical card, as a photo on your phone is not accepted.',
  },
  {
    q: 'What is the minimum age to rent?',
    a: 'You must be 18 or over and hold a licence to drive a quad yourself. Younger passengers can ride on a two-seater with an adult driver, and we have youth helmets available.',
  },
  {
    q: 'How far in advance should I book?',
    a: 'In high season, roughly December through April, book several days ahead — quads sell out, particularly around Christmas and Easter. Outside those months we can often sort out a same-day rental if you message in the morning.',
  },
  {
    q: 'Can I pay in US dollars?',
    a: 'Yes. We take colones, US dollars in cash, and card. Nothing is charged when you reserve; you pay at pickup.',
  },
];

const riding = [
  {
    q: 'I have never driven an ATV before. Is it difficult?',
    a: 'The quads are automatic, so there are no gears — it is throttle, brake and steering. We run through the controls with you before you leave and let you practise on a quiet stretch. Most people are comfortable within about ten minutes.',
  },
  {
    q: 'What are the roads actually like in Santa Teresa?',
    a: 'The main coastal road is unpaved. In dry season it is heavily corrugated and extremely dusty; in green season it softens and holds water at the low points. This is precisely why quads are the default way to get around here. Inland routes toward Manzanillo add steep climbs and river crossings, so ask us about current conditions before heading that way.',
  },
  {
    q: 'Can I ride on the beach?',
    a: 'Only where it is permitted, and never through nesting areas. Ask us and we will tell you the legal access points before you head out. Driving on protected beach sections carries real fines, so it is worth paying attention to.',
  },
  {
    q: 'Is it safe to ride at night?',
    a: 'We do not recommend it. The main road is partially unpaved and unlit, and animals are more active after dark and harder to see. Plan to be back before sunset, which is around 5:30pm most of the year.',
  },
];

const practical = [
  {
    q: 'Do you deliver to hotels?',
    a: 'Yes, free anywhere in Santa Teresa, Mal País, Playa Carmen and Playa Hermosa. We bring the quad to you, run through the controls, and collect it from the same place when your rental ends. Delivery to Cóbano or Cabuya is available for an extra fee.',
  },
  {
    q: 'What happens if the ATV breaks down?',
    a: 'Call or message us and we will come to you. If it cannot be fixed on the spot we bring a replacement quad rather than leaving you stranded. You are not charged for time lost to a mechanical fault on our side.',
  },
  {
    q: 'Is insurance included?',
    a: 'Basic liability coverage is included in every rental and we will explain its limits before you sign anything. Optional damage cover is available per day if you would rather not carry the risk yourself, which is worth considering on the rougher inland routes.',
  },
  {
    q: 'What should I wear?',
    a: 'Closed shoes are required — we cannot rent to you in flip-flops. Bring sunglasses or eye protection for the dust, sunscreen, and clothes you do not mind getting filthy. In green season, a light rain jacket is a good idea.',
  },
  {
    q: 'Can two people share one ATV?',
    a: 'Yes, at no extra cost. The rate is per quad, not per person, and every quad in our fleet has room for a passenger behind the rider. Both of you need helmets, which we supply.',
  },
];

const all = [...booking, ...riding, ...practical];
---

<BaseLayout
  title="ATV rental FAQ — Santa Teresa, Costa Rica | Rent ATV Santa Teresa"
  description="Answers to common questions about renting an ATV in Santa Teresa: licence requirements, minimum age, road conditions, insurance, hotel delivery and what to wear."
  schema={faqSchema(all)}
>
  <Breadcrumb items={[{ label: 'FAQ', href: '/faq' }]} />
  <PageHero
    eyebrow="Questions"
    title="Frequently asked questions"
    subtitle="Licences, road conditions, insurance and the practical things worth knowing before you ride. If your question is not here, message us and we will answer it."
  />

  <section class="page-x section-y" aria-labelledby="faq-booking">
    <div class="max-w-3xl">
      <SectionHeading eyebrow="Booking" title="Renting and paying" level={2} />
      <div class="mt-6"><Faq items={booking} /></div>
    </div>
  </section>

  <section class="page-x section-y" aria-labelledby="faq-riding">
    <div class="max-w-3xl">
      <SectionHeading eyebrow="On the road" title="Riding in Santa Teresa" level={2} />
      <div class="mt-6"><Faq items={riding} /></div>
    </div>
  </section>

  <section class="band-sand" aria-labelledby="faq-practical">
    <div class="page-x section-y">
    <div class="max-w-3xl">
      <SectionHeading eyebrow="Practical" title="Delivery, breakdowns and gear" level={2} />
      <div class="mt-6"><Faq items={practical} /></div>

      <p class="mt-8 text-base text-muted">
        Still deciding? Look at
        <a href="/atv-rentals" class="link-inline">what comes with a rental</a>
        or check current <a href="/pricing" class="link-inline">rates</a>.
      </p>
    </div>
    </div>
  </section>

  <CtaBand
    title="Still have a question?"
    body="Message us directly. We answer within minutes during opening hours and we would rather sort it out before you book than after."
    message="Hi! I have a question about renting an ATV in Santa Teresa."
  />
</BaseLayout>
