---
import { site, nav, whatsappLink } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas">
  <div class="page-x flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex items-center gap-2 rounded-sm" aria-label={`${site.name} — home`}>
      <svg class="h-7 w-7 shrink-0 text-accent" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="9" cy="21" r="4.5" stroke="currentColor" stroke-width="2.2" />
        <circle cx="23" cy="21" r="4.5" stroke="currentColor" stroke-width="2.2" />
        <path d="M7 14h10l3 5M12 14l2-4h4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="text-h4 font-semibold text-ink-2">Rent ATV Santa Teresa</span>
    </a>

    <nav aria-label="Main navigation" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={['tab block', isActive(item.href) && 'tab-active']}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={whatsappLink()} class="btn-primary hidden px-5 py-2.5 sm:inline-flex" rel="noopener" target="_blank">
        <WhatsAppIcon />
        Book on WhatsApp
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open main menu"
        class="flex h-12 w-12 items-center justify-center rounded-pill border border-hairline text-ink-2 transition duration-200 ease-airbnb hover:shadow-card lg:hidden"
      >
        <svg id="icon-open" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg id="icon-close" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile navigation" class="hidden border-t border-hairline bg-canvas lg:hidden">
    <ul class="page-x flex flex-col py-2">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex min-h-[48px] items-center border-b border-hairline text-base last:border-0',
              isActive(item.href) ? 'font-semibold text-ink-2' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="py-4">
        <a href={whatsappLink()} class="btn-primary w-full" rel="noopener" target="_blank">
          <WhatsAppIcon />
          Book on WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', function () {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open main menu' : 'Close main menu');
      menu.classList.toggle('hidden', open);
      iconOpen?.classList.toggle('hidden', !open);
      iconClose?.classList.toggle('hidden', open);
    });
  })();
</script>
