---
/**
 * Full-bleed dark band with a fleet photo. This is the page's main visual
 * break: the reference system is light end to end, which reads flat on a page
 * that only has a handful of photos. One dark full-width band gives the scroll
 * a beat and lets the red machines carry real contrast.
 *
 * Text sits beside the image rather than over it, so the photo is never
 * obscured and contrast never depends on the picture behind it.
 */
import { whatsappLink } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  cta?: boolean;
}
const { eyebrow, title, body, cta = true } = Astro.props;
---

<section class="on-dark">
  <div class="page-x section-y">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
      <div>
        {eyebrow && <p class="rule-marque text-body font-medium on-dark-label">{eyebrow}</p>}
        <h2 class="text-h3 on-dark-heading sm:text-h2">{title}</h2>
        <p class="mt-4 max-w-lg text-base leading-relaxed on-dark-body">{body}</p>
        {cta && (
          <a href={whatsappLink()} class="btn-primary mt-8" rel="noopener" target="_blank">
            <WhatsAppIcon class="h-4 w-4" />
            Check availability
          </a>
        )}
      </div>

      <div class="photo-card">
      <div class="flex aspect-[4/3] items-center justify-center rounded-media bg-jungle-800">
                <img src="/atv-hero-700.webp" alt="ATV rental Santa Teresa" width="200" height="132" loading="lazy" decoding="async" class="h-auto w-36 opacity-80 [filter:drop-shadow(0_8px_12px_rgba(0,0,0,0.4))]" />
              </div>
      </div>
    </div>
  </div>
</section>
