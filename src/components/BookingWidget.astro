---
/**
 * Booking request widget.
 *
 * No backend. The client picks dates and riders, a pre-filled WhatsApp message
 * is assembled client-side, and they tap "Send request" to open WhatsApp with
 * the message ready to send. The owner approves or declines in one reply.
 *
 * Pricing is calculated live from the real rate tiers so the message always
 * quotes the correct rate. The owner still confirms — this is a request, not
 * a confirmed booking.
 */
import { site, whatsappLink } from '../data/site';

interface Props {
  compact?: boolean; // true = sidebar / card variant, false = full-width
}
const { compact = false } = Astro.props;
---

<div
  class:list={[
    'rounded-media border border-hairline bg-canvas shadow-card',
    compact ? 'p-5' : 'p-6 lg:p-8',
  ]}
  id="booking-widget"
>
  <h2 class:list={['font-semibold text-ink-2', compact ? 'text-h4' : 'text-h3']}>
    Check availability
  </h2>
  <p class="mt-1 text-body text-muted">
    Select your dates and we will confirm on WhatsApp within minutes.
  </p>

  <div class="mt-6 space-y-4">
    <!-- Pickup date -->
    <div>
      <label for="bw-pickup" class="mb-1.5 block text-micro font-medium text-muted">
        Pickup date
      </label>
      <input
        type="date"
        id="bw-pickup"
        class="block w-full rounded-md border border-hairline bg-canvas px-4 py-3 text-base text-ink-2 transition duration-200 ease-airbnb hover:border-ink-2 focus:border-cta focus:outline-none focus:ring-1 focus:ring-cta"
      />
    </div>

    <!-- Return date -->
    <div>
      <label for="bw-return" class="mb-1.5 block text-micro font-medium text-muted">
        Return date
      </label>
      <input
        type="date"
        id="bw-return"
        class="block w-full rounded-md border border-hairline bg-canvas px-4 py-3 text-base text-ink-2 transition duration-200 ease-airbnb hover:border-ink-2 focus:border-cta focus:outline-none focus:ring-1 focus:ring-cta"
      />
    </div>

    <!-- Riders -->
    <div>
      <label for="bw-riders" class="mb-1.5 block text-micro font-medium text-muted">
        Number of riders
      </label>
      <select
        id="bw-riders"
        class="block w-full rounded-md border border-hairline bg-canvas px-4 py-3 text-base text-ink-2 transition duration-200 ease-airbnb hover:border-ink-2 focus:border-cta focus:outline-none focus:ring-1 focus:ring-cta"
      >
        <option value="1">1 rider</option>
        <option value="2">2 riders (passenger)</option>
      </select>
    </div>

    <!-- Quads -->
    <div>
      <label for="bw-quads" class="mb-1.5 block text-micro font-medium text-muted">
        Number of quads
      </label>
      <select
        id="bw-quads"
        class="block w-full rounded-md border border-hairline bg-canvas px-4 py-3 text-base text-ink-2 transition duration-200 ease-airbnb hover:border-ink-2 focus:border-cta focus:outline-none focus:ring-1 focus:ring-cta"
      >
        <option value="1">1 quad</option>
        <option value="2">2 quads</option>
        <option value="3">3 quads</option>
        <option value="4">4 quads</option>
      </select>
    </div>

    <!-- Hotel -->
    <div>
      <label for="bw-hotel" class="mb-1.5 block text-micro font-medium text-muted">
        Hotel or location (for delivery)
      </label>
      <input
        type="text"
        id="bw-hotel"
        placeholder="e.g. Hotel Tropico, Santa Teresa"
        class="block w-full rounded-md border border-hairline bg-canvas px-4 py-3 text-base text-ink-2 placeholder:text-muted transition duration-200 ease-airbnb hover:border-ink-2 focus:border-cta focus:outline-none focus:ring-1 focus:ring-cta"
      />
    </div>
  </div>

  <!-- Live price estimate -->
  <div
    id="bw-estimate"
    class="mt-5 hidden rounded-md bg-surface px-4 py-3"
    aria-live="polite"
    aria-atomic="true"
  >
    <div class="flex items-baseline justify-between gap-2">
      <span class="text-body text-muted">Estimated total</span>
      <span id="bw-price" class="text-h4 font-semibold text-ink-2">—</span>
    </div>
    <p id="bw-rate-note" class="mt-1 text-micro text-muted"></p>
    <p class="mt-1 text-micro text-muted">
      Final price confirmed by the owner on WhatsApp. Free delivery in Santa Teresa.
    </p>
  </div>

  <!-- Error state -->
  <p id="bw-error" class="mt-4 hidden text-body text-error" role="alert"></p>

  <!-- CTA -->
  <button
    id="bw-send"
    type="button"
    class="btn-primary mt-5 w-full"
    disabled
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/>
    </svg>
    <span id="bw-btn-label">Select dates to continue</span>
  </button>

  <p class="mt-3 text-center text-micro text-muted">
    This sends a WhatsApp message — not a confirmed booking.
    The owner will reply to confirm availability.
  </p>
</div>

<script is:inline data-wa={`https://wa.me/${site.whatsappNumber}`}>
  (function () {
    const WA_BASE = document.currentScript.dataset.wa;

    // Rate tiers matching the pricing page.
    const RATES = [
      { minDays: 14, rate: 50, label: 'two-week rate' },
      { minDays: 7,  rate: 55, label: 'weekly rate'   },
      { minDays: 3,  rate: 60, label: '3-day+ rate'   },
      { minDays: 1,  rate: 65, label: 'daily rate'    },
    ];

    const $ = id => document.getElementById(id);
    const pickup  = $('bw-pickup');
    const ret     = $('bw-return');
    const riders  = $('bw-riders');
    const quads   = $('bw-quads');
    const hotel   = $('bw-hotel');
    const estimate = $('bw-estimate');
    const priceEl  = $('bw-price');
    const rateNote = $('bw-rate-note');
    const errorEl  = $('bw-error');
    const sendBtn  = $('bw-send');
    const btnLabel = $('bw-btn-label');

    // Set min date to today.
    const pad = n => String(n).padStart(2, '0');
    const today = new Date();
    const todayStr = `${today.getFullYear()}-${pad(today.getMonth()+1)}-${pad(today.getDate())}`;
    pickup.min = todayStr;
    pickup.value = '';
    ret.min = todayStr;

    function getRate(days) {
      return RATES.find(r => days >= r.minDays);
    }

    function formatDate(str) {
      // "2025-03-14" → "14 March 2025"
      const [y, m, d] = str.split('-').map(Number);
      const months = ['January','February','March','April','May','June',
                      'July','August','September','October','November','December'];
      return `${d} ${months[m-1]} ${y}`;
    }

    function update() {
      errorEl.classList.add('hidden');
      errorEl.textContent = '';
      estimate.classList.add('hidden');
      sendBtn.disabled = true;
      btnLabel.textContent = 'Select dates to continue';

      const p = pickup.value;
      const r = ret.value;
      if (!p) return;

      // Keep return min in sync.
      ret.min = p;
      if (r && r <= p) { ret.value = ''; return; }
      if (!r) return;

      const pickupDate = new Date(p);
      const returnDate = new Date(r);
      const diffMs = returnDate - pickupDate;
      const days = Math.round(diffMs / 86400000);

      if (days < 1) {
        errorEl.textContent = 'Return date must be after pickup date.';
        errorEl.classList.remove('hidden');
        return;
      }

      const numQuads = parseInt(quads.value, 10);
      const tier = getRate(days);
      const total = tier.rate * days * numQuads;

      priceEl.textContent = `$${total.toLocaleString()} USD`;
      rateNote.textContent =
        `${days} day${days > 1 ? 's' : ''} × ${numQuads} quad${numQuads > 1 ? 's' : ''} × $${tier.rate}/day (${tier.label})`;
      estimate.classList.remove('hidden');

      sendBtn.disabled = false;
      btnLabel.textContent = 'Send request on WhatsApp';
    }

    function buildMessage() {
      const p = pickup.value;
      const r = ret.value;
      const numQuads = parseInt(quads.value, 10);
      const numRiders = parseInt(riders.value, 10);
      const days = Math.round((new Date(r) - new Date(p)) / 86400000);
      const tier = getRate(days);
      const total = tier.rate * days * numQuads;
      const hotelVal = hotel.value.trim();

      const lines = [
        `Hi! I'd like to request a quad rental in Santa Teresa.`,
        ``,
        `📅 Pickup: ${formatDate(p)}`,
        `📅 Return: ${formatDate(r)}`,
        `⏱ Duration: ${days} day${days > 1 ? 's' : ''}`,
        `🏍 Quads: ${numQuads}`,
        `👤 Riders: ${numRiders}`,
        ...(hotelVal ? [`🏨 Delivery to: ${hotelVal}`] : []),
        ``,
        `💰 Estimated total: $${total} USD (${tier.label} · $${tier.rate}/day)`,
        ``,
        `Please let me know if you have availability!`,
      ];

      return lines.join('\n');
    }

    pickup.addEventListener('change', update);
    ret.addEventListener('change', update);
    quads.addEventListener('change', update);
    riders.addEventListener('change', () => {});

    sendBtn.addEventListener('click', function () {
      const msg = buildMessage();
      const url = WA_BASE + '?text=' + encodeURIComponent(msg);
      window.open(url, '_blank', 'noopener');
    });
  })();
</script>
