---
/**
 * Booking request widget, for ATVs (default) or side-by-sides (kind="utv").
 *
 * No backend. The client picks the vehicle, dates and riders, a pre-filled
 * WhatsApp message is assembled client-side, and they tap "Send request" to
 * open WhatsApp with the message ready to send. The owner approves or declines
 * in one reply.
 *
 * Pricing is calculated live from the real rates in site.ts so the message
 * always quotes the correct price. The owner still confirms — this is a
 * request, not a confirmed booking. Only one widget per page (fixed ids).
 */
import { site, atvFleet, utvFleet, weeklyDiscount } from '../data/site';

interface Props {
  compact?: boolean; // true = sidebar / card variant, false = full-width
  kind?: 'atv' | 'utv';
}
const { compact = false, kind = 'atv' } = Astro.props;

const isUtv = kind === 'utv';

// Everything that differs between the ATV and side-by-side versions.
const config = isUtv
  ? {
      vehicleLabel: 'Side-by-side',
      vehicles: utvFleet.map((u) => ({
        id: u.id,
        name: `${u.model} ${u.seats}-seat side-by-side`,
        option: `${u.model} ${u.seats}-seat ($${u.rate8h} for 8h · $${u.rate24h}/day)`,
        rate8h: u.rate8h,
        rate24h: u.rate24h,
      })),
      riderOptions: [1, 2, 3, 4, 5],
      countLabel: 'Number of side-by-sides',
      countNoun: ['side-by-side', 'side-by-sides'],
      countMax: 3,
      allow8h: true,
      discount: null,
      intro: "Hi! I'd like to request a side-by-side (UTV) rental in Santa Teresa.",
      cta: 'booking_widget_utv',
      note: 'Final price, deposit and delivery confirmed by the owner on WhatsApp.',
    }
  : {
      vehicleLabel: 'Quad',
      vehicles: atvFleet.map((q) => ({
        id: q.id,
        name: q.name,
        option: `${q.name}, ${q.transmission.toLowerCase()} ($${q.rate24h}/day)`,
        rate8h: q.rate8h,
        rate24h: q.rate24h,
      })),
      riderOptions: [1, 2],
      countLabel: 'Number of quads',
      countNoun: ['quad', 'quads'],
      countMax: 4,
      allow8h: false,
      discount: weeklyDiscount,
      intro: "Hi! I'd like to request a quad rental in Santa Teresa.",
      cta: 'booking_widget',
      note: 'Final price confirmed by the owner on WhatsApp. Free delivery in Santa Teresa.',
    };

const fieldClass =
  'block w-full rounded-md border border-hairline bg-canvas px-4 py-3 text-base text-ink-2 transition duration-200 ease-airbnb hover:border-ink-2 focus:border-cta focus:outline-none focus:ring-1 focus:ring-cta';
const labelClass = 'mb-1.5 block text-micro font-medium text-muted';
const scriptData = {
  vehicles: config.vehicles.map(({ id, name, rate8h, rate24h }) => ({ id, name, rate8h, rate24h })),
  discount: config.discount,
  countNoun: config.countNoun,
  intro: config.intro,
  cta: config.cta,
};
---

<div
  class:list={[
    'rounded-media border border-hairline bg-canvas shadow-card',
    compact ? 'p-5' : 'p-6 lg:p-8',
  ]}
  id="booking-widget"
>
  <h2 class:list={['font-semibold text-ink-2', compact ? 'text-h4' : 'text-h3']}>
    Check availability
  </h2>
  <p class="mt-1 text-body text-muted">
    Select your dates and we will confirm on WhatsApp within minutes.
  </p>

  <div class="mt-6 space-y-4">
    <!-- Vehicle: rates differ by machine -->
    <div>
      <label for="bw-model" class={labelClass}>{config.vehicleLabel}</label>
      <select id="bw-model" class={fieldClass}>
        {config.vehicles.map((v) => <option value={v.id}>{v.option}</option>)}
      </select>
    </div>

    {config.allow8h && (
      <div>
        <label for="bw-length" class={labelClass}>Rental length</label>
        <select id="bw-length" class={fieldClass}>
          <option value="8h">8 hours (one day)</option>
          <option value="days">24 hours or more</option>
        </select>
      </div>
    )}

    <!-- Pickup date -->
    <div>
      <label for="bw-pickup" class={labelClass}>Pickup date</label>
      <input type="date" id="bw-pickup" class={fieldClass} />
    </div>

    <!-- Return date (hidden for 8-hour rentals) -->
    <div id="bw-return-row" class:list={[config.allow8h && 'hidden']}>
      <label for="bw-return" class={labelClass}>Return date</label>
      <input type="date" id="bw-return" class={fieldClass} />
    </div>

    <!-- Riders -->
    <div>
      <label for="bw-riders" class={labelClass}>Number of riders</label>
      <select id="bw-riders" class={fieldClass}>
        {config.riderOptions.map((n) => (
          <option value={n}>{n} {n === 1 ? 'rider' : 'riders'}</option>
        ))}
      </select>
    </div>

    <!-- How many vehicles -->
    <div>
      <label for="bw-quads" class={labelClass}>{config.countLabel}</label>
      <select id="bw-quads" class={fieldClass}>
        {Array.from({ length: config.countMax }, (_, i) => i + 1).map((n) => (
          <option value={n}>{n} {n === 1 ? config.countNoun[0] : config.countNoun[1]}</option>
        ))}
      </select>
    </div>

    <!-- Hotel -->
    <div>
      <label for="bw-hotel" class={labelClass}>Hotel or location (for delivery)</label>
      <input
        type="text"
        id="bw-hotel"
        placeholder="e.g. Hotel Tropico, Santa Teresa"
        class:list={[fieldClass, 'placeholder:text-muted']}
      />
    </div>
  </div>

  <!-- Live price estimate -->
  <div
    id="bw-estimate"
    class="mt-5 hidden rounded-md bg-surface px-4 py-3"
    aria-live="polite"
    aria-atomic="true"
  >
    <div class="flex items-baseline justify-between gap-2">
      <span class="text-body text-muted">Estimated total</span>
      <span id="bw-price" class="text-h4 font-semibold text-ink-2">—</span>
    </div>
    <p id="bw-rate-note" class="mt-1 text-micro text-muted"></p>
    <p class="mt-1 text-micro text-muted">{config.note}</p>
  </div>

  <!-- Error state -->
  <p id="bw-error" class="mt-4 hidden text-body text-error" role="alert"></p>

  <!-- CTA -->
  <button
    id="bw-send"
    type="button"
    class="btn-primary mt-5 w-full"
    disabled
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/>
    </svg>
    <span id="bw-btn-label">Select dates to continue</span>
  </button>

  <p class="mt-3 text-center text-micro text-muted">
    This sends a WhatsApp message — not a confirmed booking.
    The owner will reply to confirm availability.
  </p>
</div>

<script is:inline data-wa={`https://wa.me/${site.whatsappNumber}`} data-ga4={site.ga4Id} data-config={JSON.stringify(scriptData)}>
  (function () {
    const WA_BASE = document.currentScript.dataset.wa;
    const GA4_ID = document.currentScript.dataset.ga4;

    // Vehicles, rates and the weekly discount come from site.ts, so the quote
    // always matches the pricing pages.
    const CFG = JSON.parse(document.currentScript.dataset.config);

    const $ = id => document.getElementById(id);
    const model   = $('bw-model');
    const lengthSel = $('bw-length'); // only on the side-by-side version
    const pickup  = $('bw-pickup');
    const ret     = $('bw-return');
    const retRow  = $('bw-return-row');
    const riders  = $('bw-riders');
    const quads   = $('bw-quads');
    const hotel   = $('bw-hotel');
    const estimate = $('bw-estimate');
    const priceEl  = $('bw-price');
    const rateNote = $('bw-rate-note');
    const errorEl  = $('bw-error');
    const sendBtn  = $('bw-send');
    const btnLabel = $('bw-btn-label');

    // Set min date to today.
    const pad = n => String(n).padStart(2, '0');
    const today = new Date();
    const todayStr = `${today.getFullYear()}-${pad(today.getMonth()+1)}-${pad(today.getDate())}`;
    pickup.min = todayStr;
    pickup.value = '';
    ret.min = todayStr;

    const is8h = () => !!lengthSel && lengthSel.value === '8h';
    const noun = n => (n === 1 ? CFG.countNoun[0] : CFG.countNoun[1]);

    function formatDate(str) {
      // "2025-03-14" → "14 March 2025"
      const [y, m, d] = str.split('-').map(Number);
      const months = ['January','February','March','April','May','June',
                      'July','August','September','October','November','December'];
      return `${d} ${months[m-1]} ${y}`;
    }

    // Returns the quote for the current selections, or null if incomplete.
    function quote() {
      const vehicle = CFG.vehicles.find(v => v.id === model.value) || CFG.vehicles[0];
      const count = parseInt(quads.value, 10);
      const p = pickup.value;
      if (!p) return null;

      if (is8h()) {
        return { vehicle, count, days: 0, rate: vehicle.rate8h, label: '8 hours', total: vehicle.rate8h * count };
      }

      const r = ret.value;
      if (!r) return null;
      const days = Math.round((new Date(r) - new Date(p)) / 86400000);
      if (days < 1) return { error: 'Return date must be after pickup date.' };

      const weekly = CFG.discount && days >= CFG.discount.minDays;
      const rate = weekly ? Math.round(vehicle.rate24h * (1 - CFG.discount.percent / 100)) : vehicle.rate24h;
      const label = weekly ? `${CFG.discount.percent}% off over 7 days` : 'daily rate';
      return { vehicle, count, days, rate, label, total: rate * days * count };
    }

    function update() {
      errorEl.classList.add('hidden');
      errorEl.textContent = '';
      estimate.classList.add('hidden');
      sendBtn.disabled = true;
      btnLabel.textContent = 'Select dates to continue';

      if (retRow && lengthSel) retRow.classList.toggle('hidden', is8h());

      // Keep return min in sync and clear an impossible return date.
      if (pickup.value) {
        ret.min = pickup.value;
        if (ret.value && ret.value <= pickup.value) ret.value = '';
      }

      const q = quote();
      if (!q) return;
      if (q.error) {
        errorEl.textContent = q.error;
        errorEl.classList.remove('hidden');
        return;
      }

      priceEl.textContent = `$${q.total.toLocaleString()} USD`;
      rateNote.textContent = q.days
        ? `${q.days} day${q.days > 1 ? 's' : ''} × ${q.count} ${q.vehicle.name} × $${q.rate}/day (${q.label})`
        : `${q.count} ${q.vehicle.name} × $${q.rate} for 8 hours`;
      estimate.classList.remove('hidden');

      sendBtn.disabled = false;
      btnLabel.textContent = 'Send request on WhatsApp';
    }

    function buildMessage() {
      const q = quote();
      const numRiders = parseInt(riders.value, 10);
      const hotelVal = hotel.value.trim();
      const when = q.days
        ? [
            `📅 Pickup: ${formatDate(pickup.value)}`,
            `📅 Return: ${formatDate(ret.value)}`,
            `⏱ Duration: ${q.days} day${q.days > 1 ? 's' : ''}`,
          ]
        : [
            `📅 Date: ${formatDate(pickup.value)}`,
            `⏱ Duration: 8 hours`,
          ];

      const lines = [
        CFG.intro,
        ``,
        ...when,
        `🏍 ${noun(q.count).charAt(0).toUpperCase() + noun(q.count).slice(1)}: ${q.count} × ${q.vehicle.name}`,
        `👤 Riders: ${numRiders}`,
        ...(hotelVal ? [`🏨 Delivery to: ${hotelVal}`] : []),
        ``,
        q.days
          ? `💰 Estimated total: $${q.total} USD (${q.label} · $${q.rate}/day)`
          : `💰 Estimated total: $${q.total} USD (8 hours · $${q.rate} each)`,
        ``,
        `Please let me know if you have availability!`,
      ];

      return lines.join('\n');
    }

    [pickup, ret, quads, model].forEach(el => el.addEventListener('change', update));
    if (lengthSel) lengthSel.addEventListener('change', update);

    sendBtn.addEventListener('click', function () {
      const msg = buildMessage();
      const url = WA_BASE + '?text=' + encodeURIComponent(msg);
      // This is window.open, not a link click, so GTM's only GA4 trigger
      // (Link Click on wa.me) never fires for it. Send the GA4 event directly
      // with a gtag-style command; the Google tag GTM loads reads it from the
      // same dataLayer. Same event name as link clicks, so all leads count
      // together; cta_location tells them apart.
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'whatsapp_click', cta_location: CFG.cta, page_path: location.pathname });
      (function gtag() { window.dataLayer.push(arguments); })('event', 'whatsapp_click', {
        send_to: GA4_ID,
        cta_location: CFG.cta,
        page_path: location.pathname,
      });
      window.open(url, '_blank', 'noopener');
    });
  })();
</script>
