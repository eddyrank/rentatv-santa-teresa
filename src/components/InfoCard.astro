---
interface Props {
  label: string;
  value: string;
  detail?: string;
}
const { label, value, detail } = Astro.props;
---

<div class="card">
  <p class="text-body text-muted">{label}</p>
  <p class="mt-1 text-h3 font-semibold text-ink-2">{value}</p>
  {detail && <p class="mt-2 text-base text-muted">{detail}</p>}
</div>
