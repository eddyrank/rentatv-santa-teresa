---
/**
 * Responsive photo. Every image goes through here so srcset, aspect ratio and
 * loading hints stay consistent, and so width/height always match the rendered
 * shape — mismatched dimensions cause layout shift as images load.
 *
 * `ratio` takes a plain "w/h" string, e.g. "4/3" or "3/2".
 */
interface Props {
  name: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  ratio?: string;
  eager?: boolean;
  class?: string;
}

const {
  name,
  alt,
  widths = [800, 1200],
  sizes = '(min-width: 1024px) 33vw, 100vw',
  ratio = '4/3',
  eager = false,
  class: className = '',
} = Astro.props;

const [rw, rh] = ratio.split('/').map(Number);
const largest = widths[widths.length - 1];
const srcset = widths.map((w) => `/photos/${name}-${w}.webp ${w}w`).join(', ');
---

<div class:list={['overflow-hidden', className]} style={`aspect-ratio: ${rw} / ${rh}`}>
  <img
    src={`/photos/${name}-${largest}.webp`}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    width={largest}
    height={Math.round((largest * rh) / rw)}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    class="h-full w-full object-cover"
  />
</div>
