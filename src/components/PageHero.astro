---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---

<section class="page-x pt-6 lg:pt-12">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-3 max-w-3xl text-h2 sm:text-h1">{title}</h1>
  {subtitle && <p class="mt-4 max-w-2xl text-lead text-muted">{subtitle}</p>}
</section>
