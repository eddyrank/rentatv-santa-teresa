---
interface Item { q: string; a: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---

<div class="divide-y divide-hairline border-t border-hairline">
  {items.map((item) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-4 rounded-xs text-h4 text-ink-2">
        <span>{item.q}</span>
        <svg class="mt-1 h-4 w-4 shrink-0 text-ink-2 transition duration-200 ease-airbnb group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <p class="mt-3 max-w-2xl text-base text-muted">{item.a}</p>
    </details>
  ))}
</div>
