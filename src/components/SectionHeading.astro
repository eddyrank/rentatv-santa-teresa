---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  align?: 'left' | 'center';
  level?: 2 | 3;
}
const { title, subtitle, eyebrow, align = 'left', level = 2 } = Astro.props;
const Tag = `h${level}`;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class="mt-2 text-h3 sm:text-h2">{title}</Tag>
  {subtitle && <p class="mt-3 text-base text-muted">{subtitle}</p>}
</div>
