---
import { site, nav } from '../data/site';

const year = new Date().getFullYear();
---

<!-- Jungle-green footer anchors every page. Same material as the photo band
     and the conversion panel, so the site reads as one system. -->
<footer class="mt-auto on-dark">
  <div class="page-x section-y">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <h2 class="text-body font-semibold on-dark-heading">Rent ATV Santa Teresa</h2>
        <!-- NAP as crawlable text, never an image. Matches the JSON-LD exactly.
             No street line — delivery-only business, no fixed storefront. -->
        <address class="mt-4 space-y-1 text-body not-italic on-dark-body">
          <span class="block">{site.address.locality}, {site.address.region}</span>
          <span class="block">{site.address.countryName}</span>
        </address>
        <ul class="mt-4 space-y-1 text-body">
          <li><a href={`tel:${site.phoneHref}`} class="on-dark-link">{site.phoneDisplay}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-body font-semibold on-dark-heading">Hours</h2>
        <dl class="mt-4 space-y-2 text-body on-dark-body">
          {site.hours.map((block) => (
            <div class="flex justify-between gap-4 md:justify-start md:gap-3">
              <dt>{block.label}</dt>
              <dd class="text-white">{block.time}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-body on-dark-label">
          Riding after dark is not recommended. The main road is unlit and unpaved.
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <h2 class="text-body font-semibold on-dark-heading">Explore</h2>
        <ul class="mt-4 space-y-2 text-body">
          <li><a href="/" class="on-dark-link">Home</a></li>
          {nav.map((item) => (
            <li><a href={item.href} class="on-dark-link">{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t on-dark-rule pt-6 text-body on-dark-label sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}</p>
      <p>{site.areaServed.slice(0, 4).join(' · ')}</p>
    </div>
  </div>
</footer>
