---
/**
 * "Tread tide" mark: a Santa Teresa sunset where the waves are drawn as
 * knobby tire tread. The dirt road meets the Pacific in one symbol.
 *
 * Kept in sync by hand with public/favicon.svg (same 32x32 geometry).
 * Colors are the site tokens: jungle-800, marque, sand.
 */
interface Props {
  class?: string;
}

const { class: className = 'h-9 w-9' } = Astro.props;
// Header and footer can both render the mark, so the clip id must be unique.
const clipId = `logo-clip-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id={clipId}><circle cx="16" cy="16" r="16" /></clipPath>
  </defs>
  <circle cx="16" cy="16" r="16" fill="#0E2B24" />
  <path d="M7 18a9 9 0 0 1 18 0z" fill="#D6262B" />
  <g clip-path={`url(#${clipId})`} fill="none" stroke="#F3E8D8" stroke-width="2" stroke-linejoin="miter" stroke-linecap="butt">
    <path d="M-1 23.5l3-2.5 3 2.5 3-2.5 3 2.5 3-2.5 3 2.5 3-2.5 3 2.5 3-2.5 3 2.5 3-2.5" />
    <path d="M-1 28.5l3-2.5 3 2.5 3-2.5 3 2.5 3-2.5 3 2.5 3-2.5 3 2.5 3-2.5 3 2.5 3-2.5" />
  </g>
</svg>
