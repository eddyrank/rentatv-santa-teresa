---
/**
 * Social share bar for blog posts.
 *
 * Every link is a plain share-intent URL (Facebook, X, WhatsApp, Pinterest,
 * email) — no client JS, no third-party embed script. Matches the site's
 * zero-client-JS approach: these are just anchors with pre-filled query
 * params, same mechanism as whatsappLink() elsewhere on the site.
 */
interface Props {
  url: string;
  title: string;
  image?: string;
}
const { url, title, image } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const links = [
  {
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: 'M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.62.77-1.62 1.56v1.88h2.77l-.44 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z',
  },
  {
    name: 'X',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    icon: 'M18.9 2H22l-7.6 8.7L23 22h-6.9l-5.4-7-6.2 7H1.3l8.1-9.3L1 2h7l4.9 6.4L18.9 2zm-1.2 18h1.9L7 4h-2l12.7 16z',
  },
  {
    name: 'WhatsApp',
    href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`,
    icon: 'M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z',
  },
  {
    name: 'Pinterest',
    href: `https://www.pinterest.com/pin/create/button/?url=${encodedUrl}&description=${encodedTitle}${image ? `&media=${encodeURIComponent(image)}` : ''}`,
    icon: 'M12 2C6.48 2 2 6.48 2 12c0 4.24 2.63 7.86 6.34 9.32-.09-.79-.17-2.01.03-2.88.19-.79 1.22-5.02 1.22-5.02s-.31-.62-.31-1.55c0-1.45.84-2.53 1.89-2.53.89 0 1.32.67 1.32 1.47 0 .9-.57 2.24-.87 3.49-.25 1.04.53 1.9 1.55 1.9 1.87 0 3.1-2.4 3.1-5.24 0-2.16-1.45-3.78-4.1-3.78-2.98 0-4.84 2.23-4.84 4.72 0 .86.25 1.46.65 1.93.18.21.21.3.14.55-.05.18-.16.63-.2.81-.07.26-.27.35-.5.26-1.39-.57-2.04-2.08-2.04-3.79 0-2.82 2.38-6.2 7.09-6.2 3.79 0 6.28 2.74 6.28 5.68 0 3.89-2.16 6.8-5.34 6.8-1.07 0-2.07-.58-2.42-1.24 0 0-.58 2.28-.7 2.72-.21.77-.63 1.54-1.01 2.14.9.27 1.85.42 2.84.42 5.52 0 10-4.48 10-10S17.52 2 12 2z',
  },
  {
    name: 'Email',
    href: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
    icon: 'M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13zm2.2.5 7.8 6.24L19.8 6H4.2zM20 7.98l-7.38 5.9a1 1 0 0 1-1.24 0L4 7.98V18.5c0 .28.22.5.5.5h15a.5.5 0 0 0 .5-.5V7.98z',
  },
];
---

<div class="mt-12 border-t border-hairline pt-8">
  <p class="text-body font-semibold text-ink-2">Share this post</p>
  <ul class="mt-4 flex flex-wrap gap-3">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="flex h-10 w-10 items-center justify-center rounded-pill border border-hairline text-ink-2 transition duration-200 ease-airbnb hover:shadow-card"
          rel="noopener"
          target="_blank"
          aria-label={`Share on ${link.name}`}
          title={`Share on ${link.name}`}
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={link.icon} />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</div>
