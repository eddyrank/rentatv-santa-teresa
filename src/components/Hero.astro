---
import { whatsappLink } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  title: string;
  subtitle: string;
  ctaSecondary?: { label: string; href: string };
}

const { title, subtitle, ctaSecondary = { label: 'See rates', href: '/pricing' } } = Astro.props;
---

<section class="page-x section-y">
  <div class="grid items-center gap-8 lg:grid-cols-[5fr_7fr] lg:gap-12">
    <div>
      <p class="eyebrow rule-marque">Santa Teresa, Costa Rica</p>
      <h1 class="text-h2 sm:text-[52px] sm:leading-[54px]">{title}</h1>
      <p class="mt-5 max-w-xl text-lead text-muted">{subtitle}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="https://wa.me/972502416969?text=Hi!%20I'd%20like%20to%20rent%20an%20ATV%20in%20Santa%20Teresa." class="btn-primary" rel="noopener" target="_blank">
          <WhatsAppIcon class="h-4 w-4" />
          Check availability
        </a>
        <a href={ctaSecondary.href} class="btn-secondary">{ctaSecondary.label}</a>
      </div>

      <!-- Hard numbers immediately under the CTA: the two things a renter
           wants confirmed before they message. -->
      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t border-hairline pt-6">
        <div>
          <dt class="text-body text-muted">From</dt>
          <dd class="stat-num">$50<span class="text-h4 font-normal text-muted">/day</span></dd>
        </div>
        <div>
          <dt class="text-body text-muted">Delivery</dt>
          <dd class="stat-num">Free</dd>
        </div>
        <div>
          <dt class="text-body text-muted">Riders</dt>
          <dd class="stat-num">1–2</dd>
        </div>
      </dl>
    </div>

    <!-- Floating cutout of the actual Can-Am they rent. No frame or fill:
         the alpha channel does the work and a soft contact shadow keeps it
         from reading as pasted on. -->
    <div class="flex items-center justify-center">
      <img
        src="/canam-float-1200.webp"
        srcset="/canam-float-700.webp 700w, /canam-float-1200.webp 1200w"
        sizes="(min-width: 1024px) 55vw, 100vw"
        alt="Red Can-Am Outlander 450 4x4 with a locking rear cargo box, the quad available to rent in Santa Teresa"
        width="1200"
        height="1250"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-auto w-full max-w-2xl [filter:drop-shadow(0_30px_26px_rgba(0,0,0,0.22))]"
      />
    </div>
  </div>
</section>
