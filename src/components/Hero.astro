---
import { whatsappLink } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  title: string;
  subtitle: string;
  ctaSecondary?: { label: string; href: string };
}

const { title, subtitle, ctaSecondary = { label: 'See rates', href: '/pricing' } } = Astro.props;
---

<section class="page-x section-y">
  <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <div>
      <p class="eyebrow">Santa Teresa, Costa Rica</p>
      <h1 class="mt-3 text-h2 sm:text-h1">{title}</h1>
      <p class="mt-4 max-w-xl text-lead text-muted">{subtitle}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={whatsappLink()} class="btn-primary" rel="noopener" target="_blank">
          <WhatsAppIcon class="h-4 w-4" />
          Check availability
        </a>
        <a href={ctaSecondary.href} class="btn-secondary">{ctaSecondary.label}</a>
      </div>

      <p class="mt-4 text-body text-muted">
        Same-day pickup · Free hotel delivery in Santa Teresa
      </p>
    </div>

    <!-- ATV product photo: floating on gradient background -->
    <div class="flex items-center justify-center bg-gradient-to-br from-contrast to-surface rounded-media min-h-[400px]">
      <img 
        src="/hero-atv.png" 
        alt="Red Honda ATV quad bike with 4x4 storage box" 
        width="500" 
        height="400" 
        loading="eager" 
        fetchpriority="high"
        class="max-w-full h-auto drop-shadow-lg"
      />
    </div>
  </div>
</section>
