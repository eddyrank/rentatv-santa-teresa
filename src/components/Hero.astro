---
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  title: string;
  subtitle: string;
  ctaSecondary?: { label: string; href: string };
}

const { title, subtitle, ctaSecondary = { label: 'See rates', href: '/pricing' } } = Astro.props;
---

<section class="page-x section-y">
  <div class="grid items-center gap-8 lg:grid-cols-[5fr_7fr] lg:gap-12">
    <div>
      <p class="eyebrow rule-marque">Santa Teresa, Costa Rica</p>
      <h1 class="text-h2 sm:text-[52px] sm:leading-[54px]">{title}</h1>
      <p class="mt-5 max-w-xl text-lead text-muted">{subtitle}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <!-- Scrolls to the booking widget below rather than opening WhatsApp directly -->
        <a href="#book-now" class="btn-primary">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/>
          </svg>
          Check availability
        </a>
        <a href={ctaSecondary.href} class="btn-secondary">{ctaSecondary.label}</a>
      </div>

      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t border-hairline pt-6">
        <div>
          <dt class="text-body text-muted">From</dt>
          <dd class="stat-num">$50<span class="text-h4 font-normal text-muted">/day</span></dd>
        </div>
        <div>
          <dt class="text-body text-muted">Delivery</dt>
          <dd class="stat-num">Free</dd>
        </div>
        <div>
          <dt class="text-body text-muted">Riders</dt>
          <dd class="stat-num">1–2</dd>
        </div>
      </dl>
    </div>

    <!-- Hero image: floating transparent product shot -->
    <div class="flex items-center justify-center">
      <img
        src="/atv-hero-1200.webp"
        srcset="/atv-hero-700.webp 700w, /atv-hero-1200.webp 1200w"
        sizes="(min-width: 1024px) 55vw, 100vw"
        alt="Red Honda Rancher ATV with front and rear cargo racks, available to rent in Santa Teresa, Costa Rica"
        width="1200"
        height="788"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-auto w-full max-w-2xl [filter:drop-shadow(0_30px_26px_rgba(0,0,0,0.22))]"
      />
    </div>
  </div>
</section>
