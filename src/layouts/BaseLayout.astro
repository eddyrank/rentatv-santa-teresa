---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  schema?: object | object[];
  ogImage?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  robots?: string;
}

const {
  title,
  description = `${site.tagline}. Self-drive ATV rentals by the day or week. Fully automatic 4x4 quads, helmets and free hotel delivery included. Book on WhatsApp.`,
  canonical,
  schema,
  ogImage = `${site.url}/og-default.jpg`,
  twitterCard = 'summary_large_image',
  robots = 'index, follow',
} = Astro.props;

// trailingSlash is set to 'never', so strip the slash Astro leaves on interior
// paths. The root stays bare too, matching what @astrojs/sitemap emits.
const cleanPath = Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = canonical || new URL(cleanPath, Astro.site).href.replace(/\/$/, '');
const schemaBlocks = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons & theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFFFF" />

    <!-- Google Tag Manager -->
    <script set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','${site.gtmId}');`} />

    <!-- No webfont request. Airbnb Cereal VF is proprietary, so we use the
         reference's documented fallback stack, which is system-native and
         renders with zero network latency. -->

    <!-- Search -->
    <meta name="robots" content={robots} />
    <meta name="geo.region" content="CR-P" />
    <meta name="geo.placename" content="Santa Teresa, Costa Rica" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    {schemaBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe>
    </noscript>

    <!-- Skip link: ink pill, 30px radius, matching the reference recipe. -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-6 focus:top-4 focus:z-50 focus:rounded-pill focus:bg-ink-2 focus:px-5 focus:py-3 focus:text-base focus:font-semibold focus:text-canvas"
      >Skip to main content</a
    >
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>
