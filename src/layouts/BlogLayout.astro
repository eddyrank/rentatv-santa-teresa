---
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  image?: string;
  imageAlt?: string;
  tags: string[];
  slug: string;
}

const {
  title, description, pubDate, updatedDate,
  author, image, imageAlt, tags, slug,
} = Astro.props;

const canonicalUrl = `${site.url}/blog/${slug}`;
const ogImage = image || `${site.url}/og-default.jpg`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: ogImage,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  mainEntityOfPage: canonicalUrl,
  keywords: tags.join(', '),
};
---

<BaseLayout
  {/* No " | Rent ATV Santa Teresa" suffix here — post titles are already
      keyword-rich, and appending the brand pushes past Google's ~60-char
      display limit and truncates the title in search results. */}
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={articleSchema}
  ogImage={ogImage}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="page-x pt-6">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-body text-muted">
      <li><a href="/" class="hover:text-ink-2">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/blog" class="hover:text-ink-2">Blog</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink-2 truncate max-w-[200px]">{title}</li>
    </ol>
  </nav>

  <!-- Article -->
  <article class="page-x section-y">
    <div class="mx-auto max-w-2xl">

      <!-- Header -->
      <header class="mb-10">
        {tags.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-sm bg-surface px-2.5 py-1 text-micro text-muted">
                {tag}
              </span>
            ))}
          </div>
        )}

        <h1 class="text-h2 sm:text-h1 leading-tight">{title}</h1>
        <p class="mt-4 text-lead text-muted">{description}</p>

        <div class="mt-6 flex items-center gap-3 border-t border-hairline pt-5 text-body text-muted">
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {updatedDate && (
            <>
              <span>·</span>
              <span>Updated <time datetime={updatedDate.toISOString()}>
                {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time></span>
            </>
          )}
          <span>·</span>
          <span>{author}</span>
        </div>
      </header>

      <!-- Post image — real photo or branded placeholder -->
      <div class="media-frame mb-10 aspect-[16/9] overflow-hidden">
        {image ? (
          <img
            src={image}
            alt={imageAlt || title}
            width="800"
            height="450"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-cover"
          />
        ) : (
          <div class="flex h-full flex-col items-center justify-center gap-3 bg-jungle-800">
            <img
              src="/canam-float-700.webp"
              alt="ATV rental Santa Teresa, Costa Rica"
              width="280"
              height="188"
              loading="eager"
              decoding="async"
              class="h-auto w-48 opacity-90 [filter:drop-shadow(0_12px_16px_rgba(0,0,0,0.4))]"
            />
            <p class="font-sans text-xs uppercase tracking-widest text-white/40">
              Santa Teresa, Costa Rica
            </p>
          </div>
        )}
      </div>

      <!-- Body -->
      <div class="prose-content">
        <slot />
      </div>

      <!-- CTA -->
      <div class="mt-14 rounded-media bg-surface p-8 text-center">
        <h2 class="text-h3">Ready to rent an ATV in Santa Teresa?</h2>
        <p class="mt-3 text-base text-muted">
          Send your dates and we will confirm availability within minutes.
        </p>
        <a
          href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent("Hi! I'd like to rent an ATV in Santa Teresa.")}`}
          class="btn-primary mt-6 inline-flex"
          rel="noopener"
          target="_blank"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/>
          </svg>
          Check availability on WhatsApp
        </a>
      </div>

      <!-- Back link -->
      <div class="mt-8">
        <a href="/blog" class="link-inline text-base">← Back to all posts</a>
      </div>

    </div>
  </article>
</BaseLayout>
